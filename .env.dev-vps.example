# ─────────────────────────────────────────────────────────────────────────────
# FreshFlow — required environment variables
# Copy to .env (never commit .env!) and fill in real values before running.
#
# SECRETS ROTATION NOTICE:
#   The following secrets were previously committed to git and MUST be rotated:
#     - PostgreSQL password  (was: ffx_pgr_251004)
#     - Redis password       (was: redisdev123)
#   Generate new passwords and update all deployments before going to production.
#
# SSH KEY NOTICE:
#   freshflow_cd_ed25519 and freshflow_cd_ed25519.pub exist in the working tree
#   but are listed in .gitignore. Move them to a secrets manager or out of the
#   working tree entirely (e.g. ~/.ssh/) to reduce accidental exposure risk.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose: PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=freshflow
POSTGRES_USER=ffx
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_PORT=5432

# ── Docker Compose: Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540

# ── Docker Compose: API host port ────────────────────────────────────────────
API_PORT=8080

# ── .NET app: connection strings (override appsettings.json at runtime) ──────
# Use double-underscore (__) as the section separator for nested keys.
# These must be set in the process environment (or docker-compose environment:)
# so the .NET config system picks them up at runtime.
#
# Full Postgres connection string (host/port/db/user + password):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=freshflow;Username=ffx;Password=replace_with_strong_postgres_password
#
# Full Redis connection string (host:port + password if Redis AUTH is enabled):
ConnectionStrings__Redis=localhost:6379,password=replace_with_strong_redis_password,abortConnect=false

# ── .NET app: JWT ─────────────────────────────────────────────────────────────
# Key must be at least 32 characters (validated on startup via ValidateOnStart).
JWT__Key=replace_with_at_least_32_characters_random_secret
JWT__Issuer=https://dev-api.example.com
JWT__Audience=freshflow-api
JWT__AccessTokenTtlSeconds=1800
JWT__RefreshTokenTtlDays=7

# ── .NET app: Expo Push Notifications ────────────────────────────────────────
Notifications__Push__Enabled=true
# Optional: leave empty unless Expo enhanced push security is enabled.
Notifications__Push__AccessToken=

# ── .NET app: Admin seed account ─────────────────────────────────────────────
AdminSeed__Email=admin@freshflow.local
AdminSeed__Password=replace_with_strong_admin_password

# ── .NET app: Email (Resend) ──────────────────────────────────────────────────
Email__ResendApiKey=replace_with_resend_api_key
Email__FromAddress=no-reply@notifications.fishfix.vn
Email__FromName=FreshFlow
Email__FrontendBaseUrl=https://freshflow.example.com

# ── .NET app: Cloudinary signed uploads ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# ── .NET app: Goong road routing ─────────────────────────────────────────────
GOONG_API_KEY=replace_with_goong_api_key

# ── .NET app: AI Assistant (ZenMux LLM gateway) ──────────────────────────────
# Model is set in appsettings.json (z-ai/glm-4.7-flash-free); only the key is secret.
ZENMUX_API_KEY=replace_with_zenmux_api_key

# ── .NET app: AI Assistant (Gemini on Vertex AI) ─────────────────────────────
# Gemini is the primary provider; ZenMux is the failover. Gemini authenticates
# via Application Default Credentials (ADC) — there is NO API key. On a VPS
# (no browser for `gcloud auth application-default login`), use a service-account
# JSON key file:
#   1. Create an SA with role roles/aiplatform.user; download its JSON key.
#   2. Copy the key onto the VPS OUTSIDE the repo (e.g. /home/deploy/secrets/).
#      GCP_SA_KEY_HOST_PATH is that host path; docker-compose mounts it read-only
#      into the container at /secrets/gcp-sa.json. Never commit the key.
GCP_SA_KEY_HOST_PATH=/home/deploy/secrets/gcp-sa.json
# Non-secret Vertex settings. "global" uses host aiplatform.googleapis.com.
GEMINI_PROJECT_ID=replace_with_gcp_project_id
GEMINI_LOCATION=global
GEMINI_MODEL=google/gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (dotnet user-secrets)
# ─────────────────────────────────────────────────────────────────────────────
# Instead of setting environment variables locally, use dotnet user-secrets
# (stored outside the repo in ~/.microsoft/usersecrets/):
#
#   cd src/FreshFlow.API
#   dotnet user-secrets init          # once, adds UserSecretsId to .csproj
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" \
#     "Host=localhost;Port=5433;Database=freshflow;Username=ffx;Password=YOUR_PW"
#   dotnet user-secrets set "ConnectionStrings:Redis" \
#     "localhost:6379,password=YOUR_REDIS_PW,abortConnect=false"
#   dotnet user-secrets set "JWT:Key" "your-at-least-32-char-secret-key!!"
#   dotnet user-secrets set "AdminSeed:Password" "YourDevAdminPassword"
#   dotnet user-secrets set "Cloudinary:CloudName" "YOUR_CLOUDINARY_CLOUD_NAME"
#   dotnet user-secrets set "Cloudinary:ApiKey" "YOUR_CLOUDINARY_API_KEY"
#   dotnet user-secrets set "Cloudinary:ApiSecret" "YOUR_CLOUDINARY_API_SECRET"
#   dotnet user-secrets set "Delivery:Goong:ApiKey" "YOUR_GOONG_API_KEY"
#
# User-secrets are loaded automatically in the Development environment and
# take precedence over appsettings.json.
