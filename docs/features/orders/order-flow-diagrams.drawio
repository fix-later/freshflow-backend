        <mxCell id="t" value="SEQUENCE - Tạo draft, chỉnh giỏ và xác nhận order" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="850" height="50" as="geometry"/></mxCell>
        <mxCell id="u" value="Restaurant" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="120" height="810" as="geometry"/></mxCell>
