  <diagram id="order-overview" name="01 - Tổng quan">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ORDER FLOW - Kiến trúc hiện tại" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="760" height="50" as="geometry"/></mxCell>
        <mxCell id="legend" value="Xanh: đã implement  |  Vàng: kiểm tra/quy tắc  |  Đỏ nét đứt: thiếu/chưa nối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="75" width="580" height="35" as="geometry"/></mxCell>

        <mxCell id="restaurant" value="Restaurant user&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;owner của restaurant&lt;/font&gt;" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="100" height="100" as="geometry"/></mxCell>
        <mxCell id="admin" value="Admin / Operations" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="100" height="100" as="geometry"/></mxCell>
        <mxCell id="job" value="Scheduled job&lt;br&gt;chu kỳ mặc định 60s" style="shape=mxgraph.flowchart.timer;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="610" width="115" height="100" as="geometry"/></mxCell>

        <mxCell id="api" value="FreshFlow.API&lt;br&gt;&lt;b&gt;OrdersController&lt;/b&gt;&lt;br&gt;AdminController (credit)&lt;br&gt;RestaurantCreditController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="185" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="hub" value="SignalR&lt;br&gt;&lt;b&gt;/hubs/orders&lt;/b&gt;&lt;br&gt;restaurant:{id}&lt;br&gt;admin:orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="420" width="230" height="130" as="geometry"/></mxCell>

        <mxCell id="app" value="Orders.Application (CQRS / MediatR)&lt;br&gt;&lt;br&gt;Commands: draft, item, confirm, cancel,&lt;br&gt;actual quantity, receipt, issue, reorder,&lt;br&gt;scheduled order, credit&lt;br&gt;&lt;br&gt;Queries: list/detail/history/schedule/credit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="340" height="220" as="geometry"/></mxCell>
        <mxCell id="domain" value="Orders.Domain&lt;br&gt;&lt;b&gt;Order aggregate&lt;/b&gt;&lt;br&gt;OrderItem | ScheduledOrder&lt;br&gt;RestaurantCredit | CreditTransaction&lt;br&gt;OrderIssue&lt;br&gt;&lt;br&gt;State machine + business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="550" y="450" width="340" height="190" as="geometry"/></mxCell>

        <mxCell id="readers" value="Cross-module read projections&lt;br&gt;&lt;b&gt;RestaurantReader&lt;/b&gt; → restaurants&lt;br&gt;&lt;b&gt;MarketProductReader&lt;/b&gt; → market_products + products&lt;br&gt;available = current - reserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="125" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL / AppDbContext&lt;br&gt;orders | order_items&lt;br&gt;scheduled_orders | order_issues&lt;br&gt;restaurant_credit | credit_transactions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="270" height="180" as="geometry"/></mxCell>
        <mxCell id="events" value="Post-commit domain events&lt;br&gt;OrderStatusChanged → SignalR&lt;br&gt;OrderConfirmed / Cancelled&lt;br&gt;→ integration event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="620" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="missing" value="CHƯA CÓ TRONG CODE&lt;br&gt;Logistics / batching consumer&lt;br&gt;Inventory reserve/deduct consumer&lt;br&gt;Notification consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1360" y="610" width="210" height="145" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="restaurant" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
