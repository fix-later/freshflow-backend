        <mxCell id="h" value="Command Handler" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="150" height="810" as="geometry"/></mxCell>
        <mxCell id="r" value="RestaurantReader" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="150" height="810" as="geometry"/></mxCell>
        <mxCell id="p" value="MarketProductReader" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="170" height="810" as="geometry"/></mxCell>
        <mxCell id="cr" value="CreditService" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="140" height="810" as="geometry"/></mxCell>
        <mxCell id="db" value="AppDbContext" style="shape=umlLifeline;perimeter=lifelinePerimeter;lifeline=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1570" y="100" width="140" height="810" as="geometry"/></mxCell>

        <mxCell id="m1" value="POST /api/v1/orders (items, scheduledFor, notes)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="u" target="c"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="185" as="sourcePoint"/><mxPoint x="350" y="185" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="CreateDraftOrderCommand" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="225" as="sourcePoint"/><mxPoint x="610" y="225" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="resolve owner + IsApproved" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="h" target="r"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="265" as="sourcePoint"/><mxPoint x="860" y="265" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="mỗi product: price/name/available stock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="h" target="p"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="315" as="sourcePoint"/><mxPoint x="1120" y="315" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note1" value="Kiểm tra: approved; delivery trong D..D+7; product tồn tại; tổng qty theo product ≤ available. Snapshot name + current price." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="m5" value="INSERT orders + order_items (status=Draft)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="h" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="455" as="sourcePoint"/><mxPoint x="1640" y="455" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="201 draft" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c" target="u"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="505" as="sourcePoint"/><mxPoint x="100" y="505" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="edit" value="Trong Draft: POST item / PUT item / DELETE item&lt;br&gt;Mỗi add/update đọc lại stock; domain tính lại TotalAmount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="535" width="470" height="75" as="geometry"/></mxCell>

        <mxCell id="m7" value="POST /orders/{id}/confirm" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="u" target="c"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="640" as="sourcePoint"/><mxPoint x="350" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="load order + owner; CanConfirm (Draft + non-empty)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="680" as="sourcePoint"/><mxPoint x="610" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="CanCharge(total)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="h" target="cr"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="720" as="sourcePoint"/><mxPoint x="1390" y="720" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="cutoff" value="Cutoff Asia/Ho_Chi_Minh&lt;br&gt;trước 22:00 → sớm nhất D+1&lt;br&gt;từ 22:00 → sớm nhất D+2&lt;br&gt;upper bound D+7" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="745" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="m10" value="Confirm: lock prices; status=Confirmed; payment=Outstanding" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="h" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="860" as="sourcePoint"/><mxPoint x="1640" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="atomic" value="CreditService.Charge lưu order + credit + transaction trong cùng scoped AppDbContext/SaveChanges. Sau commit mới dispatch domain events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="850" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="gap" value="GAP: confirm không re-check stock, không reserve/deduct inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="635" width="390" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="state-machine" name="03 - State machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="ORDER STATE MACHINE - Domain cho phép vs application có thể kích hoạt" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="25" width="950" height="50" as="geometry"/></mxCell>
        <mxCell id="draft" value="DRAFT&lt;br&gt;payment: NotApplicable&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;được sửa items&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="confirmed" value="CONFIRMED&lt;br&gt;payment: Outstanding&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;price đã lock&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="260" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="batched" value="BATCHED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="260" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="picked" value="PICKED UP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="260" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="hub" value="AT HUB" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="260" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="delivering" value="DELIVERING" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1260" y="260" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="delivered" value="DELIVERED&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;terminal&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="cancel" value="CANCELLED&lt;br&gt;payment: Waived&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;terminal&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="e1" value="Confirm() / API có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="draft" target="confirmed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="AdvanceStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="confirmed" target="batched"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="AdvanceStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="batched" target="picked"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="AdvanceStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="picked" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="AdvanceStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="hub" target="delivering"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="AdvanceStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="delivering" target="delivered"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Cancel() / API có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="draft" target="cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Cancel() + refund / API có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="confirmed" target="cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="warning" value="GAP CHÍNH&lt;br&gt;&lt;br&gt;Order.AdvanceStatus() tồn tại và có unit test, nhưng không có command/handler/controller/consumer nào gọi nó. Vì vậy production flow dừng tại CONFIRMED (hoặc CANCELLED).&lt;br&gt;&lt;br&gt;Không có endpoint PATCH status như tài liệu thiết kế cũ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="510" width="560" height="190" as="geometry"/></mxCell>
        <mxCell id="note" value="Mỗi TransitionTo phát OrderStatusChangedDomainEvent. Sau DB commit, SignalR broadcast tới restaurant:{id} và admin:orders." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="735" width="590" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="credit-cancel" name="04 - Công nợ và hủy">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="CÔNG NỢ B2B - Confirm, cancel, settlement và credit limit" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="25" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="limit" value="Admin&lt;br&gt;PUT /admin/restaurants/{id}/credit/limit&lt;br&gt;&lt;b&gt;SetCreditLimit&lt;/b&gt;&lt;br&gt;limit không được thấp hơn outstanding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="confirm" value="Confirm order&lt;br&gt;CanCharge(total)&lt;br&gt;available = limit - outstanding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="charge" value="CHARGE&lt;br&gt;outstanding += order.total&lt;br&gt;CreditTransaction(type=charge, orderId)&lt;br&gt;Order.payment = Outstanding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="cancel" value="Cancel CONFIRMED order&lt;br&gt;chỉ trước Batched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="refund" value="REFUND&lt;br&gt;outstanding -= order.total&lt;br&gt;CreditTransaction(type=refund, orderId)&lt;br&gt;Order.payment = Waived" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="535" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="settle" value="Admin&lt;br&gt;POST /admin/restaurants/{id}/credit/settle&lt;br&gt;&lt;b&gt;SETTLEMENT&lt;/b&gt;&lt;br&gt;outstanding -= amount&lt;br&gt;transaction không gắn orderId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="account" value="restaurant_credit&lt;br&gt;PK restaurant_id&lt;br&gt;credit_limit&lt;br&gt;outstanding_balance&lt;br&gt;updated_at (concurrency token)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="340" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="history" value="GET /restaurants/{id}/credit&lt;br&gt;GET /restaurants/{id}/credit/transactions&lt;br&gt;Admin hoặc restaurant owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="610" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="limit" target="account"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="success" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="confirm" target="charge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="charge" target="account"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="cancel" target="refund"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="refund" target="account"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="settle" target="account"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="account" target="history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gap" value="GAP / SEMANTIC MISMATCH&lt;br&gt;&lt;br&gt;Settlement giảm balance tổng của restaurant nhưng không phân bổ vào từng order. Không có code chuyển OrderPaymentStatus từ Outstanding → Settled, nên trạng thái payment theo order có thể giữ Outstanding vĩnh viễn.&lt;br&gt;&lt;br&gt;ActualQuantity giảm cũng không tạo partial refund/adjustment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="260" height="245" as="geometry"/></mxCell>
        <mxCell id="atomic" value="Confirm/cancel dùng cùng scoped AppDbContext: thay đổi order + credit + transaction được commit trong cùng SaveChanges. Conflict optimistic concurrency trả 409." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="745" width="720" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="scheduled" name="05 - Recurring order">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="RECURRING / SCHEDULED ORDER - Luồng đang implement" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="25" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="create" value="Restaurant approved&lt;br&gt;POST /orders/scheduled&lt;br&gt;recurrenceType: daily | weekly&lt;br&gt;firstRunAt tương lai, notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="template" value="scheduled_orders&lt;br&gt;restaurant_id&lt;br&gt;recurrence_type&lt;br&gt;first_run_at&lt;br&gt;last_executed_at&lt;br&gt;cancelled_at&lt;br&gt;notes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="125" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="manage" value="GET list/detail/instances&lt;br&gt;PATCH update&lt;br&gt;PATCH cancel&lt;br&gt;Restaurant owner hoặc Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="timer" value="HostedService&lt;br&gt;startup + mỗi ≥10s&lt;br&gt;mặc định 60s" style="shape=mxgraph.flowchart.timer;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="405" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="due" value="GetActiveAsync&lt;br&gt;Tính mọi occurrence ≤ utcNow&lt;br&gt;Daily +1 ngày / Weekly +7 ngày&lt;br&gt;recover missed executions (max 366)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="385" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="instance" value="Tạo concrete Order&lt;br&gt;status = Draft&lt;br&gt;scheduledFor = occurrence&lt;br&gt;scheduledOrderId = template.Id&lt;br&gt;notes = template.notes&lt;br&gt;&lt;b&gt;Items = rỗng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1280" y="365" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="record" value="RecordExecution(occurrence)&lt;br&gt;last_executed_at = occurrence&lt;br&gt;SaveChanges sau batch&lt;br&gt;rerun cùng window không tạo duplicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="640" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="manual" value="Restaurant phải tìm instance, thêm item thủ công, rồi confirm như order thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="650" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="create" target="template"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="manage" target="template"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="timer" target="due"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="template" target="due"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="due" target="instance"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="instance" target="record"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="record" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gap" value="GAP&lt;br&gt;&lt;br&gt;ScheduledOrder không có line-item template. Đây chưa phải “đặt lại giỏ hàng định kỳ”; nó chỉ tạo các draft rỗng theo lịch.&lt;br&gt;&lt;br&gt;Cancel là vĩnh viễn, chưa có pause/resume. Job không có distributed lock nên nhiều API instance có rủi ro chạy đồng thời." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="560" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="fulfillment" name="06 - Fulfillment và hậu mãi">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="FULFILLMENT, NHẬN HÀNG, ISSUE VÀ REORDER" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="25" width="830" height="50" as="geometry"/></mxCell>
        <mxCell id="confirmed" value="CONFIRMED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline" value="Batched → PickedUp → AtHub → Delivering → Delivered&lt;br&gt;&lt;b&gt;Domain có, application trigger chưa có&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="125" width="490" height="120" as="geometry"/></mxCell>
        <mxCell id="delivered" value="DELIVERED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="140" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="actual" value="Admin / Operations&lt;br&gt;PATCH items/{itemId}/actual-quantity&lt;br&gt;0 ≤ actual ≤ ordered&lt;br&gt;cho mọi status trừ Draft/Cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="350" height="135" as="geometry"/></mxCell>
        <mxCell id="receipt" value="Restaurant owner&lt;br&gt;PATCH /orders/{id}/receipt&lt;br&gt;chỉ Delivered, chỉ một lần&lt;br&gt;set confirmed_receipt_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="issue" value="Restaurant owner&lt;br&gt;POST /orders/{id}/issues&lt;br&gt;chỉ Delivered&lt;br&gt;missing | wrong | damaged&lt;br&gt;optional item; affected qty; description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="320" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="issueDb" value="order_issues&lt;br&gt;status = open&lt;br&gt;Resolve() có trong entity" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="reorder" value="Bất kỳ order history của owner&lt;br&gt;POST /orders/{id}/reorder&lt;br&gt;load product/price/stock hiện tại&lt;br&gt;tạo Draft mới; copy qty + notes&lt;br&gt;không tự confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="625" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="confirmed" target="pipeline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="pipeline" target="delivered"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pipeline" target="actual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="delivered" target="receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="delivered" target="issue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="issue" target="issueDb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="history" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="delivered" target="reorder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gaps" value="GAPS&lt;br&gt;• Không có handler/API resolve issue&lt;br&gt;• ActualQuantity không đổi total/lockedTotal, không refund công nợ&lt;br&gt;• Receipt và issue không có realtime/notification event&lt;br&gt;• Report issue so affectedQuantity với ordered Quantity, không phải ActualQuantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="750" width="560" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="erd" name="07 - Data model">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="ORDER DATA MODEL - Bảng và quan hệ chính" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="25" width="800" height="50" as="geometry"/></mxCell>
        <mxCell id="restaurant" value="&lt;b&gt;restaurants&lt;/b&gt; (Auth owner)&lt;br&gt;PK Id&lt;br&gt;UserId&lt;br&gt;Status" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;PK Id&lt;br&gt;restaurant_id&lt;br&gt;order_group_id? (không có entity owner)&lt;br&gt;scheduled_order_id?&lt;br&gt;status | payment_status&lt;br&gt;scheduled_for | total_amount&lt;br&gt;cancelled_at | confirmed_receipt_at&lt;br&gt;created/updated/deleted" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="330" height="260" as="geometry"/></mxCell>
        <mxCell id="items" value="&lt;b&gt;order_items&lt;/b&gt;&lt;br&gt;PK Id&lt;br&gt;FK order_id&lt;br&gt;market_product_id&lt;br&gt;product_name_snapshot&lt;br&gt;quantity | unit_price&lt;br&gt;locked_unit_price | locked_total&lt;br&gt;actual_quantity" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="310" height="220" as="geometry"/></mxCell>
        <mxCell id="mp" value="&lt;b&gt;market_products&lt;/b&gt; (Pricing owner)&lt;br&gt;PK Id&lt;br&gt;current_price&lt;br&gt;current_quantity&lt;br&gt;reserved_quantity" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1380" y="130" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="scheduled" value="&lt;b&gt;scheduled_orders&lt;/b&gt;&lt;br&gt;PK Id&lt;br&gt;restaurant_id&lt;br&gt;recurrence_type&lt;br&gt;first_run_at | last_executed_at&lt;br&gt;cancelled_at | notes" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="issues" value="&lt;b&gt;order_issues&lt;/b&gt;&lt;br&gt;PK Id&lt;br&gt;FK order_id&lt;br&gt;FK order_item_id?&lt;br&gt;reported_by&lt;br&gt;issue_type | affected_quantity&lt;br&gt;description | status | resolved_at" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="310" height="210" as="geometry"/></mxCell>
        <mxCell id="credit" value="&lt;b&gt;restaurant_credit&lt;/b&gt;&lt;br&gt;PK/FK restaurant_id&lt;br&gt;credit_limit&lt;br&gt;outstanding_balance&lt;br&gt;updated_at (concurrency)" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="500" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="tx" value="&lt;b&gt;credit_transactions&lt;/b&gt;&lt;br&gt;PK Id&lt;br&gt;restaurant_id&lt;br&gt;order_id?&lt;br&gt;type: charge/settlement/refund/adjustment&lt;br&gt;amount | balance_after | note | created_at" style="swimlane;fontStyle=0;horizontal=1;startSize=30;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="740" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="e1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="restaurant" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="1 : N (cascade)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="orders" target="items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="logical read reference" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="items" target="mp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="1 : N generated instances" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scheduled" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="orders" target="issues"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="0..1 item" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;" edge="1" parent="1" source="issues" target="items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="restaurant" target="credit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="credit" target="tx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="optional orderId" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="tx" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Orders module đọc bảng Auth/Pricing bằng infrastructure-only projection để tránh project reference giữa module. Một số cross-module FK chỉ tồn tại ở DB/migration, không có EF navigation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="760" width="570" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="gaps" name="08 - Gaps và ưu tiên">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="ORDER FLOW REVIEW - Các khoảng trống theo mức ưu tiên" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="25" width="860" height="50" as="geometry"/></mxCell>
        <mxCell id="p0" value="P0 - Luồng chính bị chặn" style="swimlane;html=1;startSize=35;horizontal=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="470" height="330" as="geometry"/></mxCell>
        <mxCell id="p0a" value="1. Không có application/API trigger AdvanceStatus. Order không thể đi từ Confirmed tới Delivered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p0"><mxGeometry x="25" y="60" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p0b" value="2. Không có batching/logistics module hoặc consumer cho OrderConfirmedIntegrationEvent / OrderCancelledIntegrationEvent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p0"><mxGeometry x="25" y="150" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p0c" value="3. Không reserve/deduct/revalidate inventory ở confirm; nhiều draft đồng thời có thể oversell." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p0"><mxGeometry x="25" y="240" width="420" height="65" as="geometry"/></mxCell>

        <mxCell id="p1" value="P1 - Sai lệch nghiệp vụ" style="swimlane;html=1;startSize=35;horizontal=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="565" y="105" width="470" height="330" as="geometry"/></mxCell>
        <mxCell id="p1a" value="4. Scheduled order chỉ sinh draft rỗng vì template không lưu items; không phải recurring cart hoàn chỉnh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="25" y="60" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p1b" value="5. Settlement không phân bổ theo order; OrderPaymentStatus không bao giờ chuyển sang Settled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="25" y="150" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p1c" value="6. ActualQuantity không điều chỉnh locked total, outstanding balance hoặc tạo refund/adjustment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="25" y="235" width="420" height="70" as="geometry"/></mxCell>

        <mxCell id="p2" value="P2 - Workflow và vận hành" style="swimlane;html=1;startSize=35;horizontal=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1080" y="105" width="470" height="330" as="geometry"/></mxCell>
        <mxCell id="p2a" value="7. OrderIssue.Resolve tồn tại trong domain nhưng chưa có command/API/list workflow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2"><mxGeometry x="25" y="60" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2b" value="8. Scheduled job không có distributed lock; nhiều instance có thể generate cạnh tranh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2"><mxGeometry x="25" y="145" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2c" value="9. Post-commit event không có outbox; lỗi dispatch chỉ log, integration event có thể mất." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2"><mxGeometry x="25" y="230" width="420" height="70" as="geometry"/></mxCell>

        <mxCell id="flow" value="ĐỀ XUẤT THỨ TỰ HOÀN THIỆN" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="s1" value="1&lt;br&gt;Inventory reservation + confirm recheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="s2" value="2&lt;br&gt;Batching / logistics ownership + status commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="570" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="s3" value="3&lt;br&gt;Reliable integration via outbox + consumers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="570" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="s4" value="4&lt;br&gt;Recurring item template + lock/idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="570" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="s5" value="5&lt;br&gt;Credit allocation, adjustments, issue resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="570" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="scope" value="Phạm vi review: code đang có tại 2026-06-20. Tài liệu docs/04-api-design.md mô tả thêm order groups, route và status endpoint nhưng các thành phần đó chưa tồn tại trong src hiện tại." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="760" width="900" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
