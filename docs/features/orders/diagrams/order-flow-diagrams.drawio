        <mxCell id="e3" value="GenerateDue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="job" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="ISender.Send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="api" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
