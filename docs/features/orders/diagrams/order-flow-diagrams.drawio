        <mxCell id="e6" value="read Auth/Pricing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="app" target="readers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="domain" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="SavedChangesAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="db" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="OrderStatusChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="events" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="realtime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="hub" target="restaurant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="integration event - no consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="events" target="missing"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
