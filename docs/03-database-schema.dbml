// FreshFlow unified database schema for dbdiagram.io
//
// SYNC STATUS — last reconciled with code on 2026-06-29
// Source of truth: EF Core model snapshot
//   src/FreshFlow.Infrastructure.Persistence/Migrations/AppDbContextModelSnapshot.cs
//
// This file is split into two parts:
//   [A] IMPLEMENTED — tables that physically exist in the database today
//       (Auth, Catalog, Pricing, Orders, Assistant). These match the code exactly.
//   [B] PLANNED     — tables from the original design suite that are NOT yet
//       implemented. Kept here as forward-looking design; each is marked
//       "[PLANNED]". Do not assume these exist in the running DB.
//
// Key implementation deltas vs the original v2.1 design:
//   - Status columns on IMPLEMENTED tables are stored as varchar (EF string
//     conversion), NOT native PostgreSQL enum types. Allowed values are noted inline.
//   - Catalog was normalized: `categories` -> `product_categories`, and a new
//     `units_of_measurement` table replaces the free-text `products.unit_of_measure`.
//     `products` still carries legacy `category`/`unit` text columns during transition.
//   - The Payment & Billing context (invoices/payments/refunds + gateway enums) is
//     superseded by a B2B credit / công nợ model: `restaurant_credit` + `credit_transactions`.
//   - `restaurants` is 1:1 with a user (no `restaurant_members`); profile fields differ.
//   - New tables not in the original design: `delivery_addresses`, `units_of_measurement`,
//     `product_categories`, `restaurant_credit`, `credit_transactions`, `order_issues`,
//     `assistant_conversations`.

Project FreshFlow {
  database_type: 'PostgreSQL'
  Note: 'FreshFlow schema. Part A = implemented (matches EF snapshot 2026-06-29). Part B = planned design, not yet in DB.'
}

// ============================================================
// PART A — IMPLEMENTED TABLES (match the running database)
// ============================================================

// ---------- Identity & Access (Auth module) ----------

Table roles {
  id          uuid          [pk, default: `gen_random_uuid()`]
  name        varchar(50)   [unique, not null]
  description varchar(255)  [not null]
  created_at  timestamp     [not null, default: `now()`]

  Note: 'Global role lookup. One role per user via users.role_id. No is_active column in v1.'
}

Table users {
  id                 uuid          [pk, default: `gen_random_uuid()`]
  email              varchar(255)  [not null, note: 'Unique among non-deleted rows (partial index on DeletedAt IS NULL).']
  phone              varchar(20)   [note: 'Unique among non-null values (partial index). Optional login identifier.']
  password_hash      text          [not null]
  full_name          varchar(255)
  avatar_url         varchar(512)
  role_id            uuid          [not null]
  is_active          boolean       [not null, default: true]
  failed_login_count int           [not null, default: 0]
  locked_until       timestamp
  email_verified_at  timestamp
  created_at         timestamp     [not null, default: `now()`]
  updated_at         timestamp     [not null, default: `now()`]
  deleted_at         timestamp

  Indexes {
    role_id [name: 'IX_users_RoleId']
  }
  Note: 'Status is modeled by is_active + deleted_at (no user_status enum). No phone_verified_at / last_login_at in v1.'
}

Table refresh_tokens {
  id                   uuid        [pk, default: `gen_random_uuid()`]
  user_id              uuid        [not null]
  token_hash           text        [unique, not null]
  family_id            uuid        [not null, note: 'Token family for rotation + reuse detection.']
  replaced_by_token_id uuid
  revoked_at           timestamp
  revoked_reason       varchar(50)
  expires_at           timestamp   [not null]
  created_at           timestamp   [not null, default: `now()`]

  Indexes {
    family_id
    replaced_by_token_id
    user_id
  }
  Note: 'Append-only. No created_by_ip_hash / user_agent columns in v1.'
}

Table password_reset_tokens {
  id          uuid          [pk, default: `gen_random_uuid()`]
  user_id     uuid          [not null]
  token_hash  varchar(128)  [unique, not null]
  expires_at  timestamp     [not null]
  used_at     timestamp
  created_at  timestamp     [not null, default: `now()`]

  Indexes {
    user_id
  }
}

Table verification_codes {
  id          uuid          [pk, default: `gen_random_uuid()`]
  user_id     uuid          [not null]
  channel     varchar(10)   [not null, note: 'email | phone']
  code_hash   varchar(128)  [not null]
  expires_at  timestamp     [not null]
  used_at     timestamp
  created_at  timestamp     [not null, default: `now()`]

  Indexes {
    code_hash
    user_id
  }
}

Table user_market_assignments {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null]
  market_id   uuid        [not null]
  assigned_by uuid
  created_at  timestamp   [not null, default: `now()`]
  updated_at  timestamp   [not null, default: `now()`]

  Indexes {
    (user_id, market_id) [unique]
    market_id [name: 'IX_user_market_assignments_MarketId']
  }
}

Table driver_profiles {
  id            uuid          [pk, default: `gen_random_uuid()`]
  user_id       uuid          [unique, not null]
  license_plate varchar(20)
  phone_number  varchar(20)
  created_at    timestamp     [not null, default: `now()`]
  updated_at    timestamp     [not null, default: `now()`]
}

// ---------- Restaurant Profile (Auth module) ----------

Table restaurants {
  id             uuid          [pk, default: `gen_random_uuid()`]
  user_id        uuid          [unique, not null]
  name           varchar(200)  [not null]
  address        varchar(500)
  contact_person varchar(200)
  pickup_start   time
  pickup_end     time
  status         varchar(20)   [not null, default: 'pending', note: 'pending | active | suspended (stored lowercase via EF conversion).']
  created_at     timestamp     [not null, default: `now()`]
  updated_at     timestamp     [not null, default: `now()`]

  Note: '1:1 with users. No restaurant_members, business_registration, district, delivery_zone, lat/long, or approved_by in the implemented model.'
}

Table delivery_addresses {
  id             uuid          [pk, default: `gen_random_uuid()`]
  restaurant_id  uuid          [not null]
  recipient_name text
  phone          varchar(20)
  address_line   text          [not null]
  latitude       decimal(9,6)
  longitude      decimal(9,6)
  is_default     boolean       [not null, default: false]
  created_at     timestamp     [not null, default: `now()`]
  updated_at     timestamp     [not null, default: `now()`]
  deleted_at     timestamp

  Indexes {
    restaurant_id
  }
  Note: 'NEW vs original design. Per-restaurant delivery addresses.'
}

// ---------- Catalog (Catalog module) ----------

Table product_categories {
  id          uuid          [pk, default: `gen_random_uuid()`]
  name        varchar(200)  [not null, note: 'Unique among non-deleted rows (partial index).']
  is_active   boolean       [not null, default: true]
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]
  deleted_at  timestamp

  Indexes {
    is_active
    name
  }
  Note: 'Renamed from `categories`. No display_order column.'
}

Table units_of_measurement {
  id           uuid          [pk, default: `gen_random_uuid()`]
  name         varchar(100)  [not null, note: 'Unique among non-deleted rows (partial index).']
  abbreviation varchar(20)
  is_active    boolean       [not null, default: true]
  created_at   timestamp     [not null, default: `now()`]
  updated_at   timestamp     [not null, default: `now()`]
  deleted_at   timestamp

  Indexes {
    is_active
    name
  }
  Note: 'NEW vs original design. Replaces free-text products.unit_of_measure.'
}

Table products {
  id          uuid          [pk, default: `gen_random_uuid()`]
  category_id uuid          [note: 'Nullable. FK -> product_categories (ON DELETE SET NULL).']
  unit_id     uuid          [not null, note: 'FK -> units_of_measurement (ON DELETE RESTRICT).']
  name        varchar(200)  [not null]
  description varchar(1000)
  category    text          [note: 'LEGACY free-text column kept during normalization transition.']
  unit        text          [note: 'LEGACY free-text column kept during normalization transition.']
  created_by  uuid          [note: 'No DB-level FK.']
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]
  deleted_at  timestamp

  Indexes {
    category_id
    unit_id
    name
    deleted_at
  }
  Note: 'No image_url / is_active in the implemented model.'
}

// ---------- Pricing (Pricing module) ----------

Table markets {
  id          uuid          [pk, default: `gen_random_uuid()`]
  name        varchar(200)  [not null]
  location    varchar(200)
  address     varchar(500)
  latitude    decimal(9,6)
  longitude   decimal(9,6)
  is_active   boolean       [not null, default: true]
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]
  deleted_at  timestamp

  Indexes {
    is_active [name: 'idx_markets_is_active']
    deleted_at
  }
  Note: 'No `code` or operating_hours_* columns in the implemented model.'
}

Table market_products {
  id                uuid            [pk, default: `gen_random_uuid()`]
  market_id         uuid            [not null]
  product_id        uuid            [not null]
  current_price     decimal(12,2)   [not null]
  current_quantity  integer         [not null, note: 'Integer in the implemented model (design used decimal).']
  reserved_quantity integer         [not null, default: 0]
  updated_by        uuid
  created_at        timestamp       [not null, default: `now()`]
  updated_at        timestamp       [not null, default: `now()`, note: 'Concurrency token.']
  deleted_at        timestamp

  Indexes {
    (market_id, product_id) [unique, name: 'idx_market_products_market_product_unique']
    market_id [name: 'idx_market_products_market_id']
    deleted_at
  }
}

Table price_snapshots {
  id                uuid          [pk, default: `gen_random_uuid()`]
  market_product_id uuid          [not null]
  price             decimal(12,2) [not null]
  quantity          integer       [not null]
  recorded_by       uuid          [note: 'Market Agent user. No DB-level FK.']
  recorded_at       timestamp     [not null, default: `now()`]

  Indexes {
    market_product_id [name: 'idx_price_snapshots_market_product_id']
    recorded_at [name: 'idx_price_snapshots_recorded_at']
  }
  Note: 'Append-only. Range-partitioned monthly on recorded_at.'
}

// ---------- Orders (Orders module) ----------

Table orders {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  restaurant_id       uuid          [not null]
  order_group_id      uuid          [note: 'Nullable. Reserved for the PLANNED order_groups table; no FK yet.']
  scheduled_order_id  uuid          [note: 'Nullable. FK -> scheduled_orders.']
  status              varchar(20)   [not null, note: 'draft | confirmed | batched | pickedup | athub | delivering | delivered | cancelled (PascalCase via EF).']
  payment_status      varchar(20)   [not null, note: 'notapplicable | outstanding | settled | waived (PascalCase via EF).']
  scheduled_for       timestamp
  confirmed_receipt_at timestamp
  total_amount        decimal(14,2) [not null, default: 0]
  notes               text
  cancelled_at        timestamp
  cancellation_reason text
  created_at          timestamp     [not null, default: `now()`]
  updated_at          timestamp     [not null, default: `now()`, note: 'Concurrency token.']
  deleted_at          timestamp

  Indexes {
    (restaurant_id, status) [name: 'idx_orders_restaurant_id_status']
    status [name: 'idx_orders_status']
    order_group_id [name: 'idx_orders_order_group_id']
    scheduled_order_id [name: 'idx_orders_scheduled_order_id']
    scheduled_for [name: 'idx_orders_scheduled_for']
    deleted_at [name: 'IX_orders_deleted_at']
  }
  Note: 'Simplified vs original design — no order_number, created_by/confirmed_by/cancelled_by, delivery_address_snapshot, order_date, target_delivery_date, subtotal_amount, or cutoff_at.'
}

Table order_items {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  order_id              uuid          [not null]
  market_product_id     uuid          [not null]
  product_name_snapshot varchar(200)  [not null]
  quantity              integer       [not null]
  unit_price            decimal(12,2) [not null]
  locked_unit_price     decimal(12,2) [note: 'Set when order is confirmed.']
  locked_total          decimal(14,2)
  actual_quantity       decimal(10,2)
  created_at            timestamp     [not null, default: `now()`]
  updated_at            timestamp     [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_order_items_order_id']
    market_product_id [name: 'idx_order_items_market_product_id']
  }
  Note: 'No product_unit_snapshot, market_name_snapshot, actual_unit_price, or special_notes in the implemented model.'
}

Table scheduled_orders {
  id               uuid          [pk, default: `gen_random_uuid()`]
  restaurant_id    uuid          [not null]
  recurrence_type  varchar(20)   [not null, note: 'daily | weekly']
  first_run_at     timestamp     [not null]
  last_executed_at timestamp
  cancelled_at     timestamp
  notes            text
  created_at       timestamp     [not null, default: `now()`]
  updated_at       timestamp     [not null, default: `now()`]
  deleted_at       timestamp

  Indexes {
    restaurant_id [name: 'idx_scheduled_orders_restaurant_id']
    deleted_at [name: 'IX_scheduled_orders_deleted_at']
  }
  Note: 'No created_by_user_id, name, weekdays, items_json, next_run_at, timezone, or is_active in the implemented model.'
}

// ---------- B2B Credit / Công nợ (Orders module) ----------
// Replaces the original Payment & Billing context (invoices/payments/refunds).

Table restaurant_credit {
  restaurant_id       uuid          [pk]
  credit_limit        decimal(14,2) [not null]
  outstanding_balance decimal(14,2) [not null]
  updated_at          timestamp     [not null, default: `now()`, note: 'Concurrency token.']

  Note: '1:1 credit account per restaurant.'
}

Table credit_transactions {
  id            uuid          [pk, default: `gen_random_uuid()`]
  restaurant_id uuid          [not null]
  order_id      uuid          [note: 'Nullable.']
  type          varchar(20)   [not null, note: 'charge | settlement | refund | adjustment (stored lowercase via EF).']
  amount        decimal(14,2) [not null]
  balance_after decimal(14,2) [not null]
  note          varchar(500)
  created_at    timestamp     [not null, default: `now()`]

  Indexes {
    restaurant_id [name: 'idx_credit_transactions_restaurant_id']
    order_id [name: 'idx_credit_transactions_order_id']
    created_at [name: 'idx_credit_transactions_created_at']
  }
  Note: 'Append-only ledger of credit movements.'
}

Table order_issues {
  id                uuid          [pk, default: `gen_random_uuid()`]
  order_id          uuid          [not null]
  order_item_id     uuid          [note: 'Nullable. FK -> order_items (ON DELETE SET NULL).']
  issue_type        varchar(20)   [not null, note: 'missing | wrong | damaged (stored lowercase via EF).']
  affected_quantity decimal(10,2) [not null]
  description       varchar(1000) [not null]
  status            varchar(20)   [not null, note: 'open | resolved (stored lowercase via EF).']
  reported_by       uuid          [not null]
  resolved_at       timestamp
  created_at        timestamp     [not null, default: `now()`]
  updated_at        timestamp     [not null, default: `now()`]
  deleted_at        timestamp

  Indexes {
    order_id [name: 'idx_order_issues_order_id']
    order_item_id [name: 'idx_order_issues_order_item_id']
    status [name: 'idx_order_issues_status']
    deleted_at [name: 'idx_order_issues_deleted_at']
  }
  Note: 'NEW vs original design. Receipt/discrepancy reports against delivered orders.'
}

// ---------- AI Shopping Assistant (API host) ----------

Table assistant_conversations {
  id          uuid          [pk]
  user_id     uuid          [not null]
  market_id   uuid          [note: 'Nullable.']
  session_id  varchar(128)  [unique, not null]
  state       jsonb         [not null]
  expires_at  timestamp     [not null]
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]

  Indexes {
    expires_at
  }
  Note: 'NEW. DB-backed conversation store for the AI assistant (TTL via expires_at).'
}

// ======================
// PART A — REFERENCES (implemented FKs / logical relations)
// ======================

Ref: users.role_id > roles.id
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: refresh_tokens.replaced_by_token_id > refresh_tokens.id [delete: set null]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: verification_codes.user_id > users.id [delete: cascade]
Ref: user_market_assignments.user_id > users.id [delete: cascade]
Ref: user_market_assignments.market_id > markets.id [delete: cascade]
Ref: driver_profiles.user_id - users.id
Ref: restaurants.user_id - users.id [delete: cascade]
Ref: delivery_addresses.restaurant_id > restaurants.id [delete: cascade]

Ref: products.category_id > product_categories.id [delete: set null]
Ref: products.unit_id > units_of_measurement.id [delete: restrict]
Ref: market_products.market_id > markets.id
Ref: market_products.product_id > products.id
Ref: price_snapshots.market_product_id > market_products.id [delete: cascade]

Ref: orders.restaurant_id > restaurants.id [delete: restrict]
Ref: orders.scheduled_order_id > scheduled_orders.id [delete: set null]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.market_product_id > market_products.id [delete: restrict]
Ref: scheduled_orders.restaurant_id > restaurants.id [delete: restrict]

Ref: restaurant_credit.restaurant_id - restaurants.id
Ref: credit_transactions.restaurant_id > restaurants.id
Ref: credit_transactions.order_id > orders.id [delete: set null]
Ref: order_issues.order_id > orders.id [delete: cascade]
Ref: order_issues.order_item_id > order_items.id [delete: set null]

Ref: assistant_conversations.user_id > users.id
Ref: assistant_conversations.market_id > markets.id

// ============================================================
// PART B — PLANNED TABLES (design only — NOT yet in the database)
// ============================================================
// Retained from the original design suite for roadmap reference. Each table
// below is [PLANNED]. Status columns are shown as their intended PostgreSQL
// enum types; the actual implementation may instead use varchar like Part A.

Enum order_group_status {
  OPEN
  LOCKED
  DISPATCHED
  COMPLETED
  CANCELLED
}

Enum invoice_status {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

Enum payment_method_enum {
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER
  CREDIT_TERM
}

Enum payment_txn_state {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum refund_status {
  PENDING
  COMPLETED
  FAILED
}

Enum procurement_status {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum proc_order_status {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum hub_status {
  ACTIVE
  INACTIVE
}

Enum hub_receiving_status {
  IN_PROGRESS
  COMPLETED
  HAS_DISCREPANCY
}

Enum item_condition {
  OK
  DAMAGED
  MISSING
  PARTIAL
}

Enum vehicle_status {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

Enum route_status {
  PLANNED
  DISPATCHED
  COMPLETED
  CANCELLED
}

Enum stop_status {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
}

Enum driver_status {
  AVAILABLE
  ON_DUTY
  OFF_DUTY
}

Enum delivery_status {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

Enum notification_channel {
  PUSH
  SMS
  IN_APP
  EMAIL
}

Enum notification_type {
  PRICE_ALERT
  ORDER_STATUS
  DELIVERY_UPDATE
  PAYMENT
  HUB_DISCREPANCY
  SYSTEM
}

Enum export_job_status {
  PENDING
  PROCESSING
  READY
  FAILED
}

Table restaurant_members {
  id            uuid      [pk, default: `gen_random_uuid()`]
  restaurant_id uuid      [not null]
  user_id       uuid      [not null]
  is_active     boolean   [not null, default: true]
  joined_at     timestamp [not null, default: `now()`]
  left_at       timestamp
  invited_by    uuid

  Indexes {
    (restaurant_id, user_id) [unique, name: 'uq_restaurant_user']
    user_id [name: 'idx_restaurant_members_user']
  }
  Note: '[PLANNED] Multi-user restaurants. Conflicts with the current 1:1 restaurants↔users model.'
}

Table price_alert_subscriptions {
  id                   uuid          [pk, default: `gen_random_uuid()`]
  restaurant_id        uuid          [not null]
  product_id           uuid          [not null]
  threshold_percentage decimal(5,2)  [not null]
  is_active            boolean       [not null, default: true]
  created_at           timestamp     [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table system_config {
  id          uuid         [pk, default: `gen_random_uuid()`]
  key         varchar(100) [unique, not null]
  value       text         [not null]
  description text
  updated_by  uuid
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table order_groups {
  id           uuid               [pk, default: `gen_random_uuid()`]
  name         varchar(200)
  status       order_group_status [not null, default: 'OPEN']
  grouped_by   uuid
  total_orders int                [not null, default: 0]
  created_at   timestamp          [not null, default: `now()`]
  updated_at   timestamp          [not null, default: `now()`]
  deleted_at   timestamp

  Note: '[PLANNED] orders.order_group_id already exists as a nullable column reserved for this.'
}

Table order_status_history {
  id                 uuid         [pk, default: `gen_random_uuid()`]
  order_id           uuid         [not null]
  from_status        varchar(20)
  to_status          varchar(20)  [not null]
  changed_by_user_id uuid
  reason             text
  changed_at         timestamp    [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table invoices {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  invoice_number      varchar(50)   [unique, not null]
  restaurant_id       uuid          [not null]
  billing_period_start date
  billing_period_end  date
  subtotal_amount     decimal(14,2) [not null]
  tax_amount          decimal(14,2) [not null, default: 0]
  total_amount        decimal(14,2) [not null]
  status              invoice_status [not null, default: 'DRAFT']
  due_date            date
  pdf_url             varchar(500)
  issued_at           timestamp
  created_at          timestamp     [not null, default: `now()`]
  updated_at          timestamp     [not null, default: `now()`]

  Note: '[PLANNED] Superseded for now by restaurant_credit + credit_transactions.'
}

Table invoice_orders {
  invoice_id uuid          [not null]
  order_id   uuid          [not null]
  amount     decimal(14,2) [not null]

  Indexes {
    (invoice_id, order_id) [pk]
  }
  Note: '[PLANNED]'
}

Table payments {
  id                     uuid             [pk, default: `gen_random_uuid()`]
  invoice_id             uuid             [not null]
  restaurant_id          uuid             [not null]
  amount                 decimal(14,2)    [not null]
  payment_method         payment_method_enum [not null]
  gateway_transaction_id varchar(255)
  status                 payment_txn_state [not null, default: 'PENDING']
  gateway_response       jsonb
  paid_at                timestamp
  created_at             timestamp        [not null, default: `now()`]
  updated_at             timestamp        [not null, default: `now()`]

  Note: '[PLANNED] Per-gateway payment design; superseded by B2B credit model in v1.'
}

Table refunds {
  id         uuid          [pk, default: `gen_random_uuid()`]
  payment_id uuid          [not null]
  order_id   uuid          [not null]
  reason     varchar(255)  [not null]
  amount     decimal(14,2) [not null]
  status     refund_status [not null, default: 'PENDING']
  refunded_at timestamp
  created_at timestamp     [not null, default: `now()`]
  updated_at timestamp     [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table procurement_batches {
  id             uuid               [pk, default: `gen_random_uuid()`]
  order_group_id uuid
  batch_date     date               [not null]
  status         procurement_status [not null, default: 'PLANNING']
  total_orders   int                [not null, default: 0]
  created_at     timestamp          [not null, default: `now()`]
  completed_at   timestamp

  Note: '[PLANNED]'
}

Table procurement_orders {
  id           uuid             [pk, default: `gen_random_uuid()`]
  batch_id     uuid             [not null]
  agent_user_id uuid            [not null]
  market_id    uuid             [not null]
  status       proc_order_status [not null, default: 'ASSIGNED']
  started_at   timestamp
  completed_at timestamp
  created_at   timestamp        [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table procurement_items {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  procurement_order_id uuid         [not null]
  market_product_id   uuid          [not null]
  target_quantity     decimal(10,2) [not null]
  actual_quantity     decimal(10,2)
  actual_unit_price   decimal(12,2)
  source_order_ids    "uuid[]"      [not null]

  Note: '[PLANNED]'
}

Table hubs {
  id          uuid         [pk, default: `gen_random_uuid()`]
  code        varchar(20)  [unique, not null]
  name        varchar(100) [not null]
  address     varchar(255)
  latitude    decimal(10,7)
  longitude   decimal(10,7)
  status      hub_status   [not null, default: 'ACTIVE']
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`]
  deleted_at  timestamp

  Note: '[PLANNED]'
}

Table hub_inventory {
  id                 uuid          [pk, default: `gen_random_uuid()`]
  hub_id             uuid          [not null]
  market_product_id  uuid          [not null]
  quantity_in        decimal(10,2) [not null, default: 0]
  quantity_out       decimal(10,2) [not null, default: 0]
  quantity_available decimal(10,2) [not null, default: 0]
  updated_at         timestamp     [not null, default: `now()`]

  Indexes {
    (hub_id, market_product_id) [unique, name: 'uq_hub_inventory_item']
  }
  Note: '[PLANNED]'
}

Table hub_receivings {
  id                  uuid                 [pk, default: `gen_random_uuid()`]
  hub_id              uuid                 [not null]
  procurement_order_id uuid                [not null]
  received_at         timestamp            [not null, default: `now()`]
  hub_staff_user_id   uuid                 [not null]
  status              hub_receiving_status [not null, default: 'IN_PROGRESS']

  Note: '[PLANNED]'
}

Table hub_receiving_items {
  id                uuid           [pk, default: `gen_random_uuid()`]
  hub_receiving_id  uuid           [not null]
  market_product_id uuid           [not null]
  expected_quantity decimal(10,2)  [not null]
  received_quantity decimal(10,2)  [not null]
  condition_status  item_condition [not null, default: 'OK']
  notes             text

  Note: '[PLANNED]'
}

Table hub_outbound_events {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  hub_id              uuid          [not null]
  destination_route_id uuid
  items               jsonb         [not null, default: `[]`]
  total_quantity_kg   decimal(10,2)
  dispatched_at       timestamp     [not null, default: `now()`]
  recorded_by         uuid
  created_at          timestamp     [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table cross_dock_transfers {
  id               uuid         [pk, default: `gen_random_uuid()`]
  hub_id           uuid         [not null]
  hub_receiving_id uuid         [not null]
  outbound_route_id uuid        [not null]
  status           varchar(20)  [not null, default: 'PENDING']
  notes            text
  created_at       timestamp    [not null, default: `now()`]
  updated_at       timestamp    [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table vehicles {
  id           uuid           [pk, default: `gen_random_uuid()`]
  license_plate varchar(20)   [unique, not null]
  capacity_kg  decimal(8,2)   [not null]
  vehicle_type varchar(50)
  status       vehicle_status [not null, default: 'AVAILABLE']
  registered_by uuid
  created_at   timestamp      [not null, default: `now()`]
  updated_at   timestamp      [not null, default: `now()`]
  deleted_at   timestamp

  Note: '[PLANNED]'
}

Table delivery_routes {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  procurement_batch_id uuid
  order_group_id      uuid
  route_date          date          [not null]
  driver_user_id      uuid
  vehicle_id          uuid
  total_stops         int           [not null, default: 0]
  estimated_duration_minutes int
  estimated_distance_km decimal(8,2)
  optimization_metadata jsonb
  status              route_status  [not null, default: 'PLANNED']
  dispatched_at       timestamp
  completed_at        timestamp
  created_by          uuid
  created_at          timestamp     [not null, default: `now()`]
  updated_at          timestamp     [not null, default: `now()`]
  deleted_at          timestamp

  Note: '[PLANNED]'
}

Table route_stops {
  id               uuid        [pk, default: `gen_random_uuid()`]
  route_id         uuid        [not null]
  sequence_number  int         [not null]
  restaurant_id    uuid        [not null]
  order_id         uuid        [not null]
  estimated_arrival_at timestamp
  actual_arrival_at timestamp
  status           stop_status [not null, default: 'PENDING']

  Indexes {
    (route_id, sequence_number) [unique, name: 'uq_route_stop_sequence']
    order_id [unique, name: 'uq_route_stop_order']
  }
  Note: '[PLANNED]'
}

Table deliveries {
  id                  uuid            [pk, default: `gen_random_uuid()`]
  route_stop_id       uuid            [unique, not null]
  order_id            uuid            [unique, not null]
  driver_user_id      uuid
  status              delivery_status [not null, default: 'PENDING']
  departed_at         timestamp
  arrived_at          timestamp
  delivered_at        timestamp
  restaurant_confirmed_at timestamp
  signature_url       varchar(500)
  failure_reason      varchar(255)
  current_latitude    decimal(10,7)
  current_longitude   decimal(10,7)
  last_location_updated_at timestamp
  created_at          timestamp       [not null, default: `now()`]
  updated_at          timestamp       [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table notifications {
  id                  uuid                 [pk, default: `gen_random_uuid()`]
  user_id             uuid                 [not null]
  type                notification_type    [not null]
  channel             notification_channel [not null, default: 'IN_APP']
  title               varchar(200)         [not null]
  body                text                 [not null]
  related_entity_type varchar(50)
  related_entity_id   uuid
  sent_at             timestamp
  is_read             boolean              [not null, default: false]
  read_at             timestamp
  metadata            jsonb
  created_at          timestamp            [not null, default: `now()`]

  Note: '[PLANNED]'
}

Table notification_templates {
  id            uuid                 [pk, default: `gen_random_uuid()`]
  event_type    varchar(50)          [not null]
  channel       notification_channel [not null]
  template_text text                 [not null]
  is_active     boolean              [not null, default: true]

  Indexes {
    (event_type, channel) [unique, name: 'uq_notification_template']
  }
  Note: '[PLANNED]'
}

Table analytics_aggregations {
  id           uuid      [pk, default: `gen_random_uuid()`]
  type         varchar(100) [not null]
  period_start timestamp [not null]
  period_end   timestamp [not null]
  data_json    jsonb     [not null]
  created_at   timestamp [not null, default: `now()`]
  updated_at   timestamp [not null, default: `now()`]

  Indexes {
    (type, period_start, period_end) [unique, name: 'uq_analytics_period']
  }
  Note: '[PLANNED]'
}

Table export_jobs {
  id            uuid             [pk, default: `gen_random_uuid()`]
  requested_by  uuid
  export_type   varchar(100)     [not null]
  status        export_job_status [not null, default: 'PENDING']
  parameters    jsonb
  file_path     text
  error_message text
  ready_at      timestamp
  expires_at    timestamp
  created_at    timestamp        [not null, default: `now()`]
  updated_at    timestamp        [not null, default: `now()`]

  Note: '[PLANNED]'
}

// ======================
// PART B — REFERENCES (planned)
// ======================

Ref: restaurant_members.restaurant_id > restaurants.id [delete: cascade]
Ref: restaurant_members.user_id > users.id [delete: cascade]
Ref: price_alert_subscriptions.restaurant_id > restaurants.id [delete: cascade]
Ref: price_alert_subscriptions.product_id > products.id [delete: cascade]
Ref: system_config.updated_by > users.id [delete: set null]

Ref: order_groups.grouped_by > users.id [delete: set null]
Ref: order_status_history.order_id > orders.id [delete: cascade]

Ref: invoices.restaurant_id > restaurants.id [delete: restrict]
Ref: invoice_orders.invoice_id > invoices.id [delete: cascade]
Ref: invoice_orders.order_id > orders.id [delete: restrict]
Ref: payments.invoice_id > invoices.id [delete: restrict]
Ref: payments.restaurant_id > restaurants.id [delete: restrict]
Ref: refunds.payment_id > payments.id [delete: restrict]
Ref: refunds.order_id > orders.id [delete: restrict]

Ref: procurement_batches.order_group_id > order_groups.id [delete: set null]
Ref: procurement_orders.batch_id > procurement_batches.id [delete: cascade]
Ref: procurement_orders.agent_user_id > users.id [delete: restrict]
Ref: procurement_orders.market_id > markets.id [delete: restrict]
Ref: procurement_items.procurement_order_id > procurement_orders.id [delete: cascade]
Ref: procurement_items.market_product_id > market_products.id [delete: restrict]

Ref: hub_inventory.hub_id > hubs.id [delete: cascade]
Ref: hub_inventory.market_product_id > market_products.id [delete: restrict]
Ref: hub_receivings.hub_id > hubs.id [delete: restrict]
Ref: hub_receivings.procurement_order_id > procurement_orders.id [delete: restrict]
Ref: hub_receivings.hub_staff_user_id > users.id [delete: restrict]
Ref: hub_receiving_items.hub_receiving_id > hub_receivings.id [delete: cascade]
Ref: hub_receiving_items.market_product_id > market_products.id [delete: restrict]
Ref: hub_outbound_events.hub_id > hubs.id [delete: restrict]
Ref: hub_outbound_events.destination_route_id > delivery_routes.id [delete: set null]
Ref: cross_dock_transfers.hub_id > hubs.id [delete: restrict]
Ref: cross_dock_transfers.hub_receiving_id > hub_receivings.id [delete: restrict]
Ref: cross_dock_transfers.outbound_route_id > delivery_routes.id [delete: restrict]

Ref: vehicles.registered_by > users.id [delete: set null]
Ref: delivery_routes.procurement_batch_id > procurement_batches.id [delete: set null]
Ref: delivery_routes.order_group_id > order_groups.id [delete: set null]
Ref: delivery_routes.driver_user_id > users.id [delete: set null]
Ref: delivery_routes.vehicle_id > vehicles.id [delete: set null]
Ref: route_stops.route_id > delivery_routes.id [delete: cascade]
Ref: route_stops.restaurant_id > restaurants.id [delete: restrict]
Ref: route_stops.order_id > orders.id [delete: restrict]
Ref: deliveries.route_stop_id - route_stops.id [delete: restrict]
Ref: deliveries.order_id - orders.id [delete: restrict]
Ref: deliveries.driver_user_id > users.id [delete: set null]

Ref: notifications.user_id > users.id [delete: cascade]
Ref: export_jobs.requested_by > users.id [delete: set null]

// ======================
// TABLE GROUPS
// ======================

TableGroup "A1. Identity & Access (implemented)" {
  roles
  users
  refresh_tokens
  password_reset_tokens
  verification_codes
  user_market_assignments
  driver_profiles
}

TableGroup "A2. Restaurant Profile (implemented)" {
  restaurants
  delivery_addresses
}

TableGroup "A3. Catalog & Pricing (implemented)" {
  product_categories
  units_of_measurement
  products
  markets
  market_products
  price_snapshots
}

TableGroup "A4. Orders (implemented)" {
  orders
  order_items
  scheduled_orders
  order_issues
}

TableGroup "A5. Credit / Công nợ (implemented)" {
  restaurant_credit
  credit_transactions
}

TableGroup "A6. Assistant (implemented)" {
  assistant_conversations
}

TableGroup "B1. Planned — Restaurant & Catalog" {
  restaurant_members
  price_alert_subscriptions
  system_config
}

TableGroup "B2. Planned — Orders & Billing" {
  order_groups
  order_status_history
  invoices
  invoice_orders
  payments
  refunds
}

TableGroup "B3. Planned — Procurement" {
  procurement_batches
  procurement_orders
  procurement_items
}

TableGroup "B4. Planned — Hub Operations" {
  hubs
  hub_inventory
  hub_receivings
  hub_receiving_items
  hub_outbound_events
  cross_dock_transfers
}

TableGroup "B5. Planned — Logistics & Delivery" {
  vehicles
  delivery_routes
  route_stops
  deliveries
}

TableGroup "B6. Planned — Notifications & Analytics" {
  notifications
  notification_templates
  analytics_aggregations
  export_jobs
}
