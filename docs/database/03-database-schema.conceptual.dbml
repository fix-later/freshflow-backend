// FreshFlow CONCEPTUAL data model — for dbdiagram.io
//
// The highest-level, most abstract view: business entities + relationships only.
// Companion to:
//   - 03-database-schema.conceptual.md   (mermaid + glossary, source of truth for this view)
//   - 03-database-schema.logical.dbml    (attributes, keys, every meaningful relationship)
//   - 03-database-schema.dbml            (physical PostgreSQL: types, indexes, partitioning)
//
// WHY THIS LOOKS SLIGHTLY DIFFERENT FROM A "PURE" CONCEPTUAL MODEL
//   dbdiagram.io is inherently table/column based and can only draw a relationship
//   between actual columns. So each entity below carries ONLY:
//     - an identity  (id)                         → to be a drawable box
//     - the reference key(s) it needs             → to draw its relationships
//   NO business attributes, data types, indexes, or audit/soft-delete columns are shown
//   (those live in the logical/physical files). The `key` pseudo-type is used everywhere
//   as a reminder that these are identities, not real attributes.
//
// CARDINALITY:  > many-to-one   - one-to-one   <> many-to-many
//
// MAPPING TO THE LOGICAL MODEL (deliberate conceptual folds)
//   - HubInboundEvent  = logical hub_receivings + hub_receiving_items (one concept).
//   - Delivery         = logical route_stops + deliveries (one concept).
//   - order_status_history is modelled as OrderStatusHistory (business-meaningful audit
//     trail of an Order's lifecycle).
//
// REMOVED BY DECISION (see docs/06-context-decisions.md) — deliberately ABSENT
// from the conceptual and logical models; archived in the physical file only:
//   - invoices / invoice_orders / payments / refunds — superseded by the B2B credit
//     model: RestaurantCredit + CreditLedgerEntry (DEC-002).
//   - restaurant_members — single Restaurant actor, 1:1 with a User (DEC-003).
//
// Reviewed against implementation on 2026-07-03.

// =====================================================================
//  IMPLEMENTED DOMAIN
// =====================================================================

Table Role {
  id key [pk]
  Note: 'Global capability a user holds (admin, ops_manager, market_agent, hub_staff, driver, restaurant).'
}

Table User {
  id key [pk]
  role_id key
  Note: 'An account. Exactly one Role. Owns its own security credentials (tokens/codes, hidden here).'
}

Table Restaurant {
  id key [pk]
  user_id key
  Note: 'Buyer business profile, 1:1 with a User. Approval lifecycle Pending -> Active.'
}

Table Driver {
  id key [pk]
  user_id key
  Note: 'Driver profile, 1:1 with a User.'
}

Table DeliveryAddress {
  id key [pk]
  restaurant_id key
  Note: 'A place a Restaurant receives goods.'
}

Table Market {
  id key [pk]
  Note: 'A wholesale market where products are sold.'
}

Table ProductCategory {
  id key [pk]
  Note: 'Normalised product category lookup.'
}

Table UnitOfMeasure {
  id key [pk]
  Note: 'Normalised unit-of-measurement lookup.'
}

Table Product {
  id key [pk]
  category_id key
  unit_id key
  Note: 'System-wide catalog item.'
}

Table MarketProduct {
  id key [pk]
  market_id key
  product_id key
  Note: 'Current price & available quantity of a Product at a Market — the live price board.'
}

Table PriceHistory {
  id key [pk]
  market_product_id key
  Note: 'Immutable record of every price/quantity change of a MarketProduct.'
}

Table Order {
  id key [pk]
  restaurant_id key
  scheduled_order_id key
  order_group_id key
  Note: 'A restaurant purchase; Draft -> Confirmed -> ... -> Delivered.'
}

Table OrderItem {
  id key [pk]
  order_id key
  market_product_id key
  Note: 'A line on an Order; price locked at confirmation.'
}

Table ScheduledOrder {
  id key [pk]
  restaurant_id key
  Note: 'Recurring (daily/weekly) template that auto-generates Orders.'
}

Table OrderIssue {
  id key [pk]
  order_id key
  order_item_id key
  reported_by key
  Note: 'Post-delivery discrepancy report (missing/wrong/damaged).'
}

Table RestaurantCredit {
  id key [pk]
  restaurant_id key
  Note: 'B2B credit account (limit + outstanding balance / cong no) of a Restaurant.'
}

Table CreditLedgerEntry {
  id key [pk]
  restaurant_id key
  order_id key
  Note: 'Immutable credit movement (charge / settlement / refund / adjustment).'
}

Table AssistantConversation {
  id key [pk]
  user_id key
  market_id key
  Note: 'Stored AI-assistant chat session for a User, optionally scoped to a Market.'
}

// ---- implemented relationships ----
Ref classifies:        User.role_id > Role.id
Ref is_restaurant:     Restaurant.user_id - User.id
Ref is_driver:         Driver.user_id - User.id
Ref ships_to:          DeliveryAddress.restaurant_id > Restaurant.id
Ref agent_assignment:  User.id <> Market.id
Ref product_category:  Product.category_id > ProductCategory.id
Ref product_unit:      Product.unit_id > UnitOfMeasure.id
Ref offered_at:        MarketProduct.market_id > Market.id
Ref priced_as:         MarketProduct.product_id > Product.id
Ref price_records:     PriceHistory.market_product_id > MarketProduct.id
Ref places:            Order.restaurant_id > Restaurant.id
Ref generated_by:      Order.scheduled_order_id > ScheduledOrder.id
Ref schedules:         ScheduledOrder.restaurant_id > Restaurant.id
Ref contains:          OrderItem.order_id > Order.id
Ref ordered_as:        OrderItem.market_product_id > MarketProduct.id
Ref issue_of_order:    OrderIssue.order_id > Order.id
Ref issue_of_item:     OrderIssue.order_item_id > OrderItem.id
Ref reported_by:       OrderIssue.reported_by > User.id
Ref credit_account:    RestaurantCredit.restaurant_id - Restaurant.id
Ref ledger_of:         CreditLedgerEntry.restaurant_id > Restaurant.id
Ref charges:           CreditLedgerEntry.order_id > Order.id
Ref chats:             AssistantConversation.user_id > User.id
Ref chat_scope:        AssistantConversation.market_id > Market.id

TableGroup "Auth & Identity" {
  Role
  User
  Restaurant
  Driver
  DeliveryAddress
}
TableGroup "Catalog & Pricing" {
  Market
  ProductCategory
  UnitOfMeasure
  Product
  MarketProduct
  PriceHistory
}
TableGroup "Orders & Credit" {
  Order
  OrderItem
  ScheduledOrder
  OrderIssue
  RestaurantCredit
  CreditLedgerEntry
}
TableGroup "AI Assistant" {
  AssistantConversation
}

// =====================================================================
//  PLANNED / ROADMAP DOMAIN  (not yet implemented — see Sync Status)
// =====================================================================

Table PriceAlertSubscription {
  id key [pk]
  restaurant_id key
  product_id key
  Note: '[PLANNED] A Restaurant subscribing to price-change alerts for a Product.'
}

Table OrderGroup {
  id key [pk]
  Note: '[PLANNED] Batch of confirmed Orders dispatched together.'
}

Table OrderStatusHistory {
  id key [pk]
  order_id key
  Note: '[PLANNED] Audit trail of Order status transitions.'
}

Table ProcurementBatch {
  id key [pk]
  order_group_id key
  Note: '[PLANNED] One market-buying run, sourced from an OrderGroup.'
}

Table ProcurementOrder {
  id key [pk]
  batch_id key
  market_id key
  agent_user_id key
  Note: '[PLANNED] Shopping assignment of one agent at one Market within a batch.'
}

Table ProcurementItem {
  id key [pk]
  procurement_order_id key
  market_product_id key
  Note: '[PLANNED] A line to buy: target vs actual quantity of a MarketProduct.'
}

Table Hub {
  id key [pk]
  Note: '[PLANNED] Distribution hub (cross-dock point).'
}

Table HubInventory {
  id key [pk]
  hub_id key
  market_product_id key
  Note: '[PLANNED] Running stock balance of a MarketProduct at a Hub.'
}

Table HubInboundEvent {
  id key [pk]
  hub_id key
  procurement_order_id key
  Note: '[PLANNED] Goods movement into a Hub (= logical hub_receivings + hub_receiving_items), receiving a ProcurementOrder.'
}

Table HubOutboundEvent {
  id key [pk]
  hub_id key
  Note: '[PLANNED] Goods movement out of a Hub.'
}

Table CrossDockTransfer {
  id key [pk]
  hub_id key
  inbound_event_id key
  outbound_route_id key
  Note: '[PLANNED] Direct inbound -> outbound transfer at a Hub.'
}

Table Vehicle {
  id key [pk]
  Note: '[PLANNED] Delivery vehicle in the fleet.'
}

Table DeliveryRoute {
  id key [pk]
  vehicle_id key
  order_group_id key
  procurement_batch_id key
  Note: '[PLANNED] Planned route with an ordered list of stops.'
}

Table Delivery {
  id key [pk]
  route_id key
  order_id key
  Note: '[PLANNED] One delivery stop for one Order on a route (= logical route_stops + deliveries).'
}

Table Notification {
  id key [pk]
  user_id key
  Note: '[PLANNED] Per-user notification record.'
}

Table NotificationTemplate {
  id key [pk]
  Note: '[PLANNED] Reusable message template per event type and channel.'
}

Table SystemConfig {
  id key [pk]
  Note: '[PLANNED] Admin-tunable parameters (cutoff time, price-band tolerance).'
}

Table AnalyticsAggregation {
  id key [pk]
  Note: '[PLANNED] Pre-computed reporting metric.'
}

Table ExportJob {
  id key [pk]
  Note: '[PLANNED] Async CSV export request and its status.'
}

// ---- planned relationships ----
Ref alerts_for:        PriceAlertSubscription.restaurant_id > Restaurant.id
Ref alerts_on:         PriceAlertSubscription.product_id > Product.id

Ref batched_into:      Order.order_group_id > OrderGroup.id
Ref audits:            OrderStatusHistory.order_id > Order.id

Ref sourced_from:      ProcurementBatch.order_group_id > OrderGroup.id
Ref in_batch:          ProcurementOrder.batch_id > ProcurementBatch.id
Ref buys_at:           ProcurementOrder.market_id > Market.id
Ref assigned_agent:    ProcurementOrder.agent_user_id > User.id
Ref procures:          ProcurementItem.procurement_order_id > ProcurementOrder.id
Ref procured_as:       ProcurementItem.market_product_id > MarketProduct.id

Ref dispatched_by:     DeliveryRoute.order_group_id > OrderGroup.id
Ref ships_batch:       DeliveryRoute.procurement_batch_id > ProcurementBatch.id
Ref uses_vehicle:      DeliveryRoute.vehicle_id > Vehicle.id
Ref route_stop:        Delivery.route_id > DeliveryRoute.id
Ref delivers_order:    Delivery.order_id > Order.id

Ref hub_stock:         HubInventory.hub_id > Hub.id
Ref stock_of_product:  HubInventory.market_product_id > MarketProduct.id
Ref inbound_at:        HubInboundEvent.hub_id > Hub.id
Ref receives_po:       HubInboundEvent.procurement_order_id > ProcurementOrder.id
Ref outbound_at:       HubOutboundEvent.hub_id > Hub.id
Ref xdock_hub:         CrossDockTransfer.hub_id > Hub.id
Ref xdock_in:          CrossDockTransfer.inbound_event_id > HubInboundEvent.id
Ref xdock_out:         CrossDockTransfer.outbound_route_id > DeliveryRoute.id

Ref notifies:          Notification.user_id > User.id

TableGroup "Restaurant & Catalog (planned)" {
  PriceAlertSubscription
  SystemConfig
}
TableGroup "Orders (planned)" {
  OrderGroup
  OrderStatusHistory
}
TableGroup "Procurement (planned)" {
  ProcurementBatch
  ProcurementOrder
  ProcurementItem
}
TableGroup "Hub (planned)" {
  Hub
  HubInventory
  HubInboundEvent
  HubOutboundEvent
  CrossDockTransfer
}
TableGroup "Logistics (planned)" {
  Vehicle
  DeliveryRoute
  Delivery
}
TableGroup "Notifications & Analytics (planned)" {
  Notification
  NotificationTemplate
  AnalyticsAggregation
  ExportJob
}
