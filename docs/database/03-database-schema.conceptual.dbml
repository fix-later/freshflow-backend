// FreshFlow CONCEPTUAL data model for dbdiagram.io
// Reconciled with the implemented EF model on 2026-08-16.
// One box per current persisted concept; only identities and relationship keys are shown.

Project FreshFlow_Conceptual {
  database_type: 'Conceptual'
  Note: '59 implemented persistence concepts. Attributes, indexes, defaults, and planned entities are omitted.'
}

Table assistant_conversations {
  id                               key [pk]
  market_id                        key
  user_id                          key
}

Table audit_logs {
  id                               key [pk]
  actor_id                         key
  entity_id                        key
}

Table credit_statement_lines {
  id                               key [pk]
  credit_statement_id              key
  order_id                         key
  transaction_id                   key
}

Table credit_statements {
  id                               key [pk]
  restaurant_id                    key
}

Table credit_transactions {
  id                               key [pk]
  order_id                         key
  recorded_by_user_id              key
  restaurant_id                    key
}

Table cross_dock_transfers {
  id                               key [pk]
  hub_id                           key
  inbound_event_id                 key
  outbound_route_id                key
}

Table deliveries {
  id                               key [pk]
  delivery_route_id                key
  order_id                         key
}

Table delivery_addresses {
  id                               key [pk]
  restaurant_id                    key
}

Table delivery_issues {
  id                               key [pk]
  delivery_id                      key
  reported_by                      key
}

Table delivery_routes {
  id                               key [pk]
  created_by                       key
  driver_user_id                   key
  hub_id                           key
  market_session_id                key
  order_group_id                   key
  route_plan_id                    key
  suggested_vehicle_id             key
  vehicle_id                       key
}

Table driver_profiles {
  id                               key [pk]
  user_id                          key
}

Table hub_discrepancies {
  id                               key [pk]
  acknowledged_by                  key
  hub_id                           key
  inbound_event_id                 key
  order_id                         key
  order_item_id                    key
}

Table hub_driver_assignments {
  hub_id                           key [pk]
  user_id                          key [pk]
}

Table hub_handover_events {
  id                               key [pk]
  delivery_route_id                key
  driver_user_id                   key
  handed_over_by                   key
  hub_id                           key
  outbound_event_id                key
}

Table hub_inbound_events {
  id                               key [pk]
  delivery_route_id                key
  delivery_schedule_id             key
  hub_id                           key
  hub_staff_user_id                key
  recorded_by                      key
  source_market_id                 key
}

Table hub_inventory {
  id                               key [pk]
  hub_id                           key
  market_product_id                key
}

Table hub_outbound_events {
  id                               key [pk]
  destination_route_id             key
  hub_id                           key
  recorded_by                      key
}

Table hub_sorting_progress {
  id                               key [pk]
  hub_id                           key
  order_item_id                    key
  route_id                         key
  sorted_by_user_id                key
}

Table hub_staff_assignments {
  hub_id                           key [pk]
  user_id                          key [pk]
}

Table hubs {
  id                               key [pk]
  managed_by                       key
  market_id                        key
}

Table invoice_lines {
  id                               key [pk]
  invoice_id                       key
}

Table invoices {
  id                               key [pk]
  order_id                         key
  restaurant_id                    key
}

Table market_product_tags {
  market_product_id                key [pk]
  tag_id                           key [pk]
}

Table market_products {
  id                               key [pk]
  market_id                        key
  product_id                       key
  updated_by                       key
}

Table market_session_agents {
  session_id                       key [pk]
  user_id                          key [pk]
  assigned_by                      key
}

Table market_session_vehicles {
  session_id                       key [pk]
  vehicle_id                       key [pk]
  assigned_by                      key
}

Table market_sessions {
  id                               key [pk]
  closed_by                        key
  hub_id                           key
  market_id                        key
}

Table markets {
  id                               key [pk]
}

Table notification_devices {
  id                               key [pk]
  user_id                          key
}

Table notifications {
  id                               key [pk]
  user_id                          key
}

Table operational_settings {
  id                               key [pk]
}

Table order_claims {
  id                               key [pk]
  created_by                       key
  order_id                         key
  refund_transaction_id            key
  restaurant_id                    key
  reviewed_by                      key
}

Table order_issues {
  id                               key [pk]
  order_id                         key
  order_item_id                    key
  reported_by                      key
}

Table order_items {
  id                               key [pk]
  market_product_id                key
  order_id                         key
}

Table orders {
  id                               key [pk]
  delivery_address_id              key
  market_id                        key
  market_session_id                key
  order_group_id                   key
  restaurant_id                    key
  scheduled_order_id               key
}

Table packing_codes {
  id                               key [pk]
}

Table password_reset_tokens {
  id                               key [pk]
  user_id                          key
}

Table price_snapshots {
  id                               key [pk]
  market_product_id                key
  recorded_by                      key
}

Table procurement_batch_items {
  id                               key [pk]
  assigned_agent_user_id           key
  market_product_id                key
  procurement_batch_id             key
}

Table procurement_batch_orders {
  id                               key [pk]
  order_id                         key
  procurement_batch_id             key
}

Table procurement_batches {
  id                               key [pk]
  assigned_agent_user_id           key
  hub_id                           key
  market_id                        key
  market_session_id                key
}

Table procurement_exceptions {
  id                               key [pk]
  market_product_id                key
  procurement_batch_id             key
  reported_by_user_id              key
}

Table product_categories {
  id                               key [pk]
  parent_id                        key
}

Table products {
  id                               key [pk]
  category_id                      key
  created_by                       key
  packing_code_id                  key
  unit_id                          key
}

Table refresh_tokens {
  id                               key [pk]
  family_id                        key
  replaced_by_token_id             key
  user_id                          key
}

Table restaurant_credit {
  restaurant_id                    key [pk]
}

Table restaurant_favorites {
  id                               key [pk]
  market_product_id                key
  restaurant_id                    key
}

Table restaurants {
  id                               key [pk]
  user_id                          key
}

Table roles {
  id                               key [pk]
}

Table route_matrix_cache {
  pair_key                         key [pk]
}

Table route_plans {
  id                               key [pk]
  hub_id                           key
  market_session_id                key
}

Table scheduled_order_items {
  id                               key [pk]
  market_product_id                key
  scheduled_order_id               key
}

Table scheduled_orders {
  id                               key [pk]
  delivery_address_id              key
  market_id                        key
  restaurant_id                    key
}

Table tags {
  id                               key [pk]
  updated_by                       key
}

Table units_of_measurement {
  id                               key [pk]
}

Table user_market_assignments {
  id                               key [pk]
  assigned_by                      key
  market_id                        key
  user_id                          key
}

Table users {
  id                               key [pk]
  role_id                          key
}

Table vehicles {
  id                               key [pk]
  hub_id                           key
  registered_by                    key
}

Table verification_codes {
  id                               key [pk]
  user_id                          key
}

// Enforced relationships
Ref: credit_statement_lines.credit_statement_id > credit_statements.id
Ref: cross_dock_transfers.hub_id > hubs.id
Ref: cross_dock_transfers.inbound_event_id > hub_inbound_events.id
