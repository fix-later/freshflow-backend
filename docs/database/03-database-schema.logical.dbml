}

Table procurement_batch_items {
  id                               uuid [pk, not null]
  actual_quantity                  int
  actual_unit_price                decimal
  assigned_agent_user_id           uuid
  assigned_at                      datetime
  market_product_id                uuid [not null]
  procurement_batch_id             uuid [not null]
  product_name_snapshot            string [not null]
  purchased_at                     datetime
  reference_unit_price             decimal
  total_quantity                   int [not null]
}

