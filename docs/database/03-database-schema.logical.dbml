}

Table scheduled_orders {
  id                               uuid [pk, not null]
  cancelled_at                     datetime
  delivery_address_id              uuid
  first_run_at                     datetime [not null]
  last_executed_at                 datetime
  market_id                        uuid
  notes                            string
  recurrence_type                  string [not null]
  restaurant_id                    uuid [not null]
}

Table tags {
  id                               uuid [pk, not null]
  name                             string [not null, unique]
  pins_to_top                      boolean [not null]
  updated_by                       uuid
}

Table units_of_measurement {
  id                               uuid [pk, not null]
  abbreviation                     string
  is_active                        boolean [not null]
  name                             string [not null, unique]
}

Table user_market_assignments {
  id                               uuid [pk, not null]
  assigned_by                      uuid
  market_id                        uuid [not null]
  user_id                          uuid [not null]
}

Table users {
  id                               uuid [pk, not null]
  avatar_url                       string
