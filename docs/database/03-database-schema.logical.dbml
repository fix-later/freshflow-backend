}

Table order_items {
  id                               uuid [pk, not null]
  actual_quantity                  decimal
  actual_unit_price                decimal
  locked_total                     decimal
  locked_unit_price                decimal
  locked_vat_amount                decimal
  market_product_id                uuid [not null]
  order_id                         uuid [not null]
  packing_code_snapshot            string
  packing_weight_kg_snapshot       decimal
  product_name_snapshot            string [not null]
  quantity                         int [not null]
  unit_price                       decimal [not null]
  vat_rate_code                    string
  vat_rate_percent                 decimal
}

Table orders {
  id                               uuid [pk, not null]
  cancellation_reason              string
  cancelled_at                     datetime
  confirmed_at                     datetime
  confirmed_receipt_at             datetime
  delivery_address_id              uuid
  delivery_address_line            string
  delivery_distance_km             decimal [not null]
  delivery_distance_meters         int
  delivery_duration_seconds        int
  delivery_fee                     decimal [not null]
  delivery_fee_calculated_at       datetime
  delivery_latitude                decimal
  delivery_longitude               decimal
  delivery_origin_latitude         decimal
  delivery_origin_longitude        decimal
  delivery_phone                   string
  delivery_recipient_name          string
  market_id                        uuid
  market_session_id                uuid
  notes                            string
  order_group_id                   uuid
  payment_status                   string [not null]
  restaurant_id                    uuid [not null]
  routing_provider                 string
  scheduled_for                    datetime
  scheduled_order_id               uuid
  status                           string [not null]
  subtotal_amount                  decimal [not null]
  total_amount                     decimal [not null]
  vat_amount                       decimal [not null]
}

Table packing_codes {
  id                               uuid [pk, not null]
  capacity_kg                      decimal [not null]
  code                             string [not null, unique]
  description                      string
