// FreshFlow LOGICAL data model for dbdiagram.io
// Reconciled with the implemented EF model on 2026-08-16.
// Includes 59 current tables; physical storage details and planned entities are omitted.

Project FreshFlow_Logical {
  database_type: 'Logical'
  Note: 'Technology-neutral attributes, keys, enforced relationships, and cross-module logical links.'
}

Table assistant_conversations {
  id                               uuid [pk, not null]
  expires_at                       datetime [not null]
  market_id                        uuid
  session_id                       string [not null, unique]
  state_json                       json [not null]
  user_id                          uuid [not null]
}

Table audit_logs {
  id                               uuid [pk, not null]
  action                           string [not null]
  actor_id                         uuid
  details                          json
  entity_id                        uuid [not null]
  entity_type                      string [not null]
  occurred_at                      datetime [not null]
}

Table credit_statement_lines {
  id                               uuid [pk, not null]
  amount                           decimal [not null]
  balance_after                    decimal [not null]
  credit_statement_id              uuid [not null]
  note                             string
  occurred_at                      datetime [not null]
  order_id                         uuid
  payment_method                   string
  reference                        string
  transaction_id                   uuid [not null]
  type                             string [not null]
}

Table credit_statements {
  id                               uuid [pk, not null]
  closing_balance                  decimal [not null]
  generated_at                     datetime [not null]
  opening_balance                  decimal [not null]
  period_end                       datetime [not null]
  period_start                     datetime [not null]
  restaurant_id                    uuid [not null]
  total_charges                    decimal [not null]
  total_refunds                    decimal [not null]
  total_settlements                decimal [not null]
}

Table credit_transactions {
  id                               uuid [pk, not null]
  amount                           decimal [not null]
  balance_after                    decimal [not null]
  note                             string
  order_id                         uuid
  payment_method                   string
  recorded_by_user_id              uuid
  reference                        string
  restaurant_id                    uuid [not null]
  type                             string [not null]
}

Table cross_dock_transfers {
  id                               uuid [pk, not null]
  hub_id                           uuid [not null]
  inbound_event_id                 uuid [not null]
  notes                            string
  outbound_route_id                uuid [not null]
  status                           string [not null]
}

Table deliveries {
  id                               uuid [pk, not null]
  actual_arrival                   datetime
  delivery_route_id                uuid [not null]
  estimated_arrival                datetime
  failure_reason                   string
  order_id                         uuid [not null, unique]
  proof_url                        string
  sequence_number                  int [not null]
  status                           string [not null]
}

Table delivery_addresses {
  id                               uuid [pk, not null]
  address_line                     string [not null]
  is_default                       boolean [not null]
  latitude                         decimal
  longitude                        decimal
  phone                            string
  recipient_name                   string
  restaurant_id                    uuid [not null]
}

Table delivery_issues {
  id                               uuid [pk, not null]
  delivery_id                      uuid [not null]
  description                      string [not null]
  issue_type                       string [not null]
  reported_by                      uuid [not null]
  status                           string [not null]
}

Table delivery_routes {
  id                               uuid [pk, not null]
  created_by                       uuid
  driver_user_id                   uuid
  estimated_cost                   decimal
  estimated_duration_minutes       int
  estimated_return_at              datetime
  hub_id                           uuid
  market_session_id                uuid [not null]
  optimization_criteria            string
  order_group_id                   uuid
  planned_load_kg                  decimal
  route_plan_id                    uuid
  route_type                       string [not null]
  routing_profile                  string
  service_date                     date [not null]
  status                           string [not null]
  stops                            json [not null]
  suggested_vehicle_id             uuid
  total_distance_km                decimal
  vehicle_id                       uuid
}

Table driver_profiles {
  id                               uuid [pk, not null]
  license_plate                    string
  phone_number                     string
  user_id                          uuid [not null, unique]
}

Table hub_discrepancies {
  id                               uuid [pk, not null]
  acknowledged_at                  datetime
  acknowledged_by                  uuid
  affected_quantity                decimal [not null]
  condition_status                 string [not null]
  hub_id                           uuid [not null]
  inbound_event_id                 uuid [not null]
  notes                            string
  order_id                         uuid [not null]
  order_item_id                    uuid [not null]
  proof_image_url                  string
  status                           string [not null]
}

Table hub_driver_assignments {
  hub_id                           uuid [pk, not null]
  user_id                          uuid [pk, not null]
}

Table hub_handover_events {
  id                               uuid [pk, not null]
  delivery_route_id                uuid [not null]
  driver_confirmed_at              datetime
  driver_user_id                   uuid [not null]
  handed_over_at                   datetime [not null]
  handed_over_by                   uuid [not null]
  hub_id                           uuid [not null]
  notes                            string
  outbound_event_id                uuid
  status                           string [not null]
}

Table hub_inbound_events {
  id                               uuid [pk, not null]
  arrived_at                       datetime [not null]
  condition_status                 string [not null]
  delivery_route_id                uuid
  delivery_schedule_id             uuid
  discrepancy_notes                string
  hub_id                           uuid [not null]
  hub_staff_user_id                uuid
  items                            json [not null]
  recorded_by                      uuid
  source_market_id                 uuid
  status                           string [not null]
  total_quantity_kg                decimal [not null]
}

Table hub_inventory {
  id                               uuid [pk, not null]
  hub_id                           uuid [not null]
  market_product_id                uuid [not null]
  quantity_available               decimal [not null]
  quantity_in                      decimal [not null]
  quantity_out                     decimal [not null]
  recorded_at                      datetime [not null]
}

Table hub_outbound_events {
  id                               uuid [pk, not null]
  destination_route_id             uuid [not null]
  dispatched_at                    datetime [not null]
  hub_id                           uuid [not null]
  items                            json [not null]
  recorded_by                      uuid
  total_quantity_kg                decimal [not null]
}

Table hub_sorting_progress {
  id                               uuid [pk, not null]
  hub_id                           uuid [not null]
  order_item_id                    uuid [not null]
  route_id                         uuid
  service_date                     date [not null]
  sorted_at                        datetime
  sorted_by_user_id                uuid
  sorted_quantity_kg               decimal [not null]
  status                           string [not null]
}

Table hub_staff_assignments {
  hub_id                           uuid [pk, not null]
  user_id                          uuid [pk, not null]
}

Table hubs {
  id                               uuid [pk, not null]
  address                          string
  capacity_kg                      decimal [not null]
  is_active                        boolean [not null]
  latitude                         decimal
  longitude                        decimal
  managed_by                       uuid
  market_id                        uuid [unique]
  name                             string [not null]
  occupied_capacity_kg             decimal [not null]
}

Table invoice_lines {
  id                               uuid [pk, not null]
  invoice_id                       uuid [not null]
  line_subtotal                    decimal [not null]
  line_total                       decimal [not null]
  line_vat_amount                  decimal [not null]
  product_name                     string [not null]
  quantity                         decimal [not null]
  unit                             string
  unit_price                       decimal [not null]
  vat_rate_code                    string [not null]
  vat_rate_percent                 decimal [not null]
}

Table invoices {
  id                               uuid [pk, not null]
  buyer_address                    string
  buyer_email                      string
  buyer_legal_name                 string [not null]
  buyer_tax_code                   string [not null]
  error_reason                     string
  issued_at                        datetime
  lookup_url                       string
  number                           string
  order_id                         uuid [not null, unique]
  pdf_ref                          string
  provider_name                    string
  restaurant_id                    uuid [not null]
  retry_count                      int [not null]
  serial                           string
  status                           string [not null]
  sub_total                        decimal [not null]
  tax_authority_code               string
  total                            decimal [not null]
  vat_amount                       decimal [not null]
  xml_ref                          string
}

Table market_product_tags {
  market_product_id                uuid [pk, not null]
  tag_id                           uuid [pk, not null]
}

Table market_products {
  id                               uuid [pk, not null]
  current_price                    decimal [not null]
  current_quantity                 int [not null]
  market_id                        uuid [not null]
  product_id                       uuid [not null]
  reserved_quantity                int [not null]
  updated_by                       uuid
}

Table market_session_agents {
  session_id                       uuid [pk, not null]
  user_id                          uuid [pk, not null]
  assigned_at                      datetime [not null]
  assigned_by                      uuid
}

Table market_session_vehicles {
  session_id                       uuid [pk, not null]
  vehicle_id                       uuid [pk, not null]
  assigned_at                      datetime [not null]
  assigned_by                      uuid
}

Table market_sessions {
  id                               uuid [pk, not null]
  batching_completed_at            datetime
  close_reason                     string
  closed_at                        datetime
  closed_by                        uuid
  closes_at                        datetime [not null]
  created_source                   string [not null]
  hub_id                           uuid
  market_id                        uuid [not null]
  planned_capacity_kg              decimal
  service_date                     date [not null]
  status                           string [not null]
}

Table markets {
  id                               uuid [pk, not null]
  address                          string
  code                             string
  description                      string
  image_url                        string
  is_active                        boolean [not null]
  latitude                         decimal
  location                         string
  longitude                        decimal
  name                             string [not null]
}

Table notification_devices {
  id                               uuid [pk, not null]
  device_id                        string [unique]
  platform                         string [not null]
