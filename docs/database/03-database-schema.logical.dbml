}

Table vehicles {
  id                               uuid [pk, not null]
  capacity_kg                      decimal [not null]
  hub_id                           uuid
  is_available                     boolean [not null]
  plate_number                     string [not null, unique]
  registered_by                    uuid
  vehicle_type                     string [not null]
}

Table verification_codes {
  id                               uuid [pk, not null]
  channel                          string [not null]
  expires_at                       datetime [not null]
  used_at                          datetime
  user_id                          uuid [not null]
}

// Enforced relationships
Ref: credit_statement_lines.credit_statement_id > credit_statements.id
Ref: cross_dock_transfers.hub_id > hubs.id
Ref: cross_dock_transfers.inbound_event_id > hub_inbound_events.id
Ref: deliveries.delivery_route_id > delivery_routes.id
Ref: delivery_addresses.restaurant_id > restaurants.id
Ref: delivery_issues.delivery_id > deliveries.id
Ref: delivery_routes.route_plan_id > route_plans.id
Ref: hub_discrepancies.hub_id > hubs.id
Ref: hub_discrepancies.inbound_event_id > hub_inbound_events.id
Ref: hub_driver_assignments.hub_id > hubs.id
Ref: hub_handover_events.hub_id > hubs.id
Ref: hub_handover_events.outbound_event_id > hub_outbound_events.id
Ref: hub_inbound_events.hub_id > hubs.id
Ref: hub_inventory.hub_id > hubs.id
Ref: hub_outbound_events.hub_id > hubs.id
Ref: hub_staff_assignments.hub_id > hubs.id
Ref: invoice_lines.invoice_id > invoices.id
Ref: market_product_tags.market_product_id > market_products.id
Ref: market_product_tags.tag_id > tags.id
Ref: market_session_agents.session_id > market_sessions.id
Ref: market_session_vehicles.session_id > market_sessions.id
Ref: order_claims.order_id > orders.id
Ref: order_claims.refund_transaction_id > credit_transactions.id
Ref: order_issues.order_id > orders.id
Ref: order_issues.order_item_id > order_items.id
Ref: order_items.order_id > orders.id
Ref: password_reset_tokens.user_id > users.id
Ref: price_snapshots.market_product_id > market_products.id
Ref: procurement_batch_items.procurement_batch_id > procurement_batches.id
Ref: procurement_batch_orders.procurement_batch_id > procurement_batches.id
Ref: procurement_batches.market_session_id > market_sessions.id
Ref: procurement_exceptions.procurement_batch_id > procurement_batches.id
Ref: product_categories.parent_id > product_categories.id
Ref: products.packing_code_id > packing_codes.id
Ref: products.category_id > product_categories.id
Ref: products.unit_id > units_of_measurement.id
Ref: refresh_tokens.replaced_by_token_id > refresh_tokens.id
Ref: refresh_tokens.user_id > users.id
Ref: scheduled_order_items.scheduled_order_id > scheduled_orders.id
Ref: user_market_assignments.user_id > users.id
Ref: users.role_id > roles.id
Ref: verification_codes.user_id > users.id

// Cross-module/application relationships (not database-enforced)
Ref: assistant_conversations.user_id > users.id [color: #9e9e9e] // logical only
Ref: assistant_conversations.market_id > markets.id [color: #9e9e9e] // logical only
Ref: audit_logs.actor_id > users.id [color: #9e9e9e] // logical only
Ref: credit_statement_lines.order_id > orders.id [color: #9e9e9e] // logical only
Ref: credit_statement_lines.transaction_id > credit_transactions.id [color: #9e9e9e] // logical only
Ref: credit_statements.restaurant_id > restaurants.id [color: #9e9e9e] // logical only
Ref: credit_transactions.order_id > orders.id [color: #9e9e9e] // logical only
Ref: credit_transactions.recorded_by_user_id > users.id [color: #9e9e9e] // logical only
Ref: credit_transactions.restaurant_id > restaurants.id [color: #9e9e9e] // logical only
Ref: cross_dock_transfers.outbound_route_id > delivery_routes.id [color: #9e9e9e] // logical only
Ref: deliveries.order_id - orders.id [color: #9e9e9e] // logical only
Ref: delivery_issues.reported_by > users.id [color: #9e9e9e] // logical only
Ref: delivery_routes.created_by > users.id [color: #9e9e9e] // logical only
Ref: delivery_routes.driver_user_id > users.id [color: #9e9e9e] // logical only
Ref: delivery_routes.hub_id > hubs.id [color: #9e9e9e] // logical only
Ref: delivery_routes.market_session_id > market_sessions.id [color: #9e9e9e] // logical only
Ref: delivery_routes.suggested_vehicle_id > vehicles.id [color: #9e9e9e] // logical only
Ref: delivery_routes.vehicle_id > vehicles.id [color: #9e9e9e] // logical only
Ref: driver_profiles.user_id - users.id [color: #9e9e9e] // logical only
Ref: hub_discrepancies.acknowledged_by > users.id [color: #9e9e9e] // logical only
Ref: hub_discrepancies.order_id > orders.id [color: #9e9e9e] // logical only
Ref: hub_discrepancies.order_item_id > order_items.id [color: #9e9e9e] // logical only
