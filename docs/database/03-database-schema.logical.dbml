}

Table products {
  id                               uuid [pk, not null]
  category_id                      uuid
  created_by                       uuid
  description                      string
  image_url                        string
  legacy_category                  string
  legacy_unit                      string
  minimum_order_quantity           int [not null]
  name                             string [not null]
  packing_code_id                  uuid
  unit_id                          uuid [not null]
  vat_rate                         string
}

Table refresh_tokens {
  id                               uuid [pk, not null]
  expires_at                       datetime [not null]
  family_id                        uuid [not null]
  replaced_by_token_id             uuid
  revoked_at                       datetime
  revoked_reason                   string
  user_id                          uuid [not null]
}

Table restaurant_credit {
  restaurant_id                    uuid [pk, not null]
  credit_limit                     decimal [not null]
  last_alerted_level               string [not null]
  outstanding_balance              decimal [not null]
}

Table restaurant_favorites {
  id                               uuid [pk, not null]
  market_product_id                uuid [not null]
  restaurant_id                    uuid [not null]
}

Table restaurants {
  id                               uuid [pk, not null]
  address                          string
  business_license_url             string
  contact_person                   string
  invoice_address                  string
  invoice_email                    string
  invoice_legal_name               string
  name                             string [not null]
  pickup_end                       time
  pickup_start                     time
  status                           string [not null]
  tax_code                         string
  user_id                          uuid [not null, unique]
}

Table roles {
  id                               uuid [pk, not null]
  description                      string [not null]
  name                             string [not null, unique]
}

Table route_matrix_cache {
  pair_key                         string [pk, not null]
  calculated_at                    datetime [not null]
  distance_meters                  long [not null]
  duration_seconds                 long [not null]
  from_latitude                    decimal [not null]
  from_longitude                   decimal [not null]
  profile                          string [not null]
  to_latitude                      decimal [not null]
  to_longitude                     decimal [not null]
}

Table route_plans {
  id                               uuid [pk, not null]
  approved_at                      datetime
  estimated_cost                   decimal [not null]
  estimated_duration_minutes       int [not null]
  hub_id                           uuid [not null]
  input_revision                   string [not null]
  is_estimated                     boolean [not null]
  market_session_id                uuid [not null]
  optimization_criteria            string [not null]
  routing_provider                 string [not null]
  service_date                     date [not null]
  status                           string [not null]
  total_distance_km                decimal [not null]
  total_load_kg                    decimal [not null]
  unassigned                       json [not null]
  vehicles_used                    int [not null]
}

Table scheduled_order_items {
  id                               uuid [pk, not null]
  market_product_id                uuid [not null]
  quantity                         int [not null]
