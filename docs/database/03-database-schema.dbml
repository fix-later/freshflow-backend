  send_status                      varchar(20) [not null, default: 'pending']
  title                            text [not null]
  type                             varchar(50) [not null]
  user_id                          uuid [not null]

  Indexes {
    (attempt_count, last_attempt_at) [name: 'idx_notifications_retry_scan', note: 'WHERE send_status = \'failed\'']
    user_id [name: 'idx_notifications_user_id']
    (user_id, is_read, created_at, id) [name: 'idx_notifications_user_read_created']
  }
}

