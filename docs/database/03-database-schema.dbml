  CreatedAt                        timestamptz [not null]
  CreatedBy                        uuid [not null]
  DecisionNote                     varchar(1000)
  OrderId                          uuid [not null]
  Reason                           varchar(500) [not null]
  RefundTransactionId              uuid
  RestaurantId                     uuid [not null]
  ReviewedAt                       timestamptz
  ReviewedBy                       uuid
  Status                           varchar(20) [not null]
  UpdatedAt                        timestamptz [not null]
  deleted_at                       timestamptz

  Indexes {
    deleted_at [name: 'IX_order_claims_deleted_at']
    OrderId [name: 'idx_order_claims_order_id']
    (RestaurantId, Status, CreatedAt) [name: 'idx_order_claims_restaurant_status_created_at']
    RefundTransactionId [unique, name: 'ux_order_claims_refund_transaction_id', note: 'WHERE "RefundTransactionId" IS NOT NULL']
  }
  Note: 'CHECK ck_order_claims_amount_positive: "Amount" > 0'
}

Table order_issues {
  id                               uuid [pk, not null]
  affected_quantity                numeric(10,2) [not null]
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  description                      varchar(1000) [not null]
  issue_type                       varchar(20) [not null]
  order_id                         uuid [not null]
  order_item_id                    uuid
  reported_by                      uuid [not null]
  resolved_at                      timestamptz
  status                           varchar(20) [not null]
  updated_at                       timestamptz [not null]

  Indexes {
    deleted_at [name: 'idx_order_issues_deleted_at']
    order_id [name: 'idx_order_issues_order_id']
    order_item_id [name: 'idx_order_issues_order_item_id']
    status [name: 'idx_order_issues_status']
  }
}

Table order_items {
  Id                               uuid [pk, not null]
  ActualQuantity                   numeric(10,2)
  ActualUnitPrice                  numeric(12,2)
  CreatedAt                        timestamptz [not null]
  LockedTotal                      numeric(14,2)
  LockedUnitPrice                  numeric(12,2)
  MarketProductId                  uuid [not null]
  OrderId                          uuid [not null]
  ProductNameSnapshot              varchar(200) [not null]
  Quantity                         integer [not null]
  UnitPrice                        numeric(12,2) [not null]
  UpdatedAt                        timestamptz [not null]
  locked_vat_amount                numeric(14,2)
  packing_code_snapshot            varchar(50)
  packing_weight_kg_snapshot       numeric(12,3)
  vat_rate_code                    varchar(10)
  vat_rate_percent                 numeric(5,2)

  Indexes {
    MarketProductId [name: 'idx_order_items_market_product_id']
    OrderId [name: 'idx_order_items_order_id']
  }
}

Table orders {
  Id                               uuid [pk, not null]
  CancellationReason               text
  CancelledAt                      timestamptz
  CreatedAt                        timestamptz [not null]
  Notes                            text
  OrderGroupId                     uuid
  PaymentStatus                    varchar(20) [not null]
  RestaurantId                     uuid [not null]
  ScheduledFor                     timestamptz
  ScheduledOrderId                 uuid
  Status                           varchar(20) [not null]
  TotalAmount                      numeric(14,2) [not null]
  UpdatedAt                        timestamptz [not null]
  confirmed_at                     timestamptz
  confirmed_receipt_at             timestamptz
  deleted_at                       timestamptz
  delivery_address_id              uuid
  delivery_address_line            text
  delivery_distance_km             numeric(10,2) [not null]
  delivery_distance_meters         integer
  delivery_duration_seconds        integer
  delivery_fee                     numeric(14,2) [not null]
  delivery_fee_calculated_at       timestamptz
  delivery_latitude                numeric(9,6)
  delivery_longitude               numeric(9,6)
  delivery_origin_latitude         numeric(9,6)
  delivery_origin_longitude        numeric(9,6)
  delivery_phone                   varchar(20)
  delivery_recipient_name          text
  market_id                        uuid
  market_session_id                uuid
  routing_provider                 text
  subtotal_amount                  numeric(14,2) [not null]
  vat_amount                       numeric(14,2) [not null]

  Indexes {
    deleted_at [name: 'IX_orders_deleted_at']
    (market_id, ScheduledFor) [name: 'idx_orders_market_scheduled_for', note: 'WHERE market_id IS NOT NULL AND deleted_at IS NULL']
    market_session_id [name: 'idx_orders_market_session_id', note: 'WHERE market_session_id IS NOT NULL AND deleted_at IS NULL']
    OrderGroupId [name: 'idx_orders_order_group_id']
    (RestaurantId, Status) [name: 'idx_orders_restaurant_id_status']
    ScheduledFor [name: 'idx_orders_scheduled_for']
    ScheduledOrderId [name: 'idx_orders_scheduled_order_id']
    Status [name: 'idx_orders_status']
  }
}

Table packing_codes {
  Id                               uuid [pk, not null]
  CapacityKg                       numeric(12,3) [not null]
  Code                             varchar(50) [not null]
  CreatedAt                        timestamptz [not null]
  DeletedAt                        timestamptz
  Description                      varchar(500)
  IsActive                         boolean [not null]
  UpdatedAt                        timestamptz [not null]

  Indexes {
    Code [unique, name: 'IX_packing_codes_Code', note: 'WHERE "DeletedAt" IS NULL']
    DeletedAt [name: 'IX_packing_codes_DeletedAt']
  }
}

Table password_reset_tokens {
  Id                               uuid [pk, not null]
  CreatedAt                        timestamptz [not null]
  ExpiresAt                        timestamptz [not null]
  TokenHash                        varchar(128) [not null, unique]
  UsedAt                           timestamptz
  UserId                           uuid [not null]

  Indexes {
    TokenHash [unique, name: 'IX_password_reset_tokens_TokenHash']
    UserId [name: 'IX_password_reset_tokens_UserId']
  }
}

Table price_snapshots {
  Id                               uuid [pk, not null]
  MarketProductId                  uuid [not null]
  Price                            numeric(12,2) [not null]
  Quantity                         integer [not null]
  RecordedAt                       timestamptz [not null]
  RecordedBy                       uuid

  Indexes {
    MarketProductId [name: 'idx_price_snapshots_market_product_id']
    RecordedAt [name: 'idx_price_snapshots_recorded_at']
  }
}

Table procurement_batch_items {
  id                               uuid [pk, not null, default: `gen_random_uuid()`]
  actual_quantity                  integer
  actual_unit_price                numeric(12,2)
  assigned_agent_user_id           uuid
  assigned_at                      timestamptz
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  market_product_id                uuid [not null]
  procurement_batch_id             uuid [not null]
  product_name_snapshot            varchar(200) [not null]
  purchased_at                     timestamptz
  reference_unit_price             numeric(12,2)
  total_quantity                   integer [not null]
  updated_at                       timestamptz [not null]

  Indexes {
    assigned_agent_user_id [name: 'idx_procurement_batch_items_assigned_agent', note: 'WHERE "assigned_agent_user_id" IS NOT NULL']
    procurement_batch_id [name: 'idx_procurement_batch_items_batch_id']
  }
}

Table procurement_batch_orders {
  id                               uuid [pk, not null, default: `gen_random_uuid()`]
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  order_id                         uuid [not null]
  procurement_batch_id             uuid [not null]
  updated_at                       timestamptz [not null]

  Indexes {
    procurement_batch_id [name: 'idx_procurement_batch_orders_batch_id']
    order_id [unique, name: 'ux_procurement_batch_orders_order_active', note: 'WHERE "deleted_at" IS NULL']
  }
}

Table procurement_batches {
  id                               uuid [pk, not null, default: `gen_random_uuid()`]
  assigned_agent_user_id           uuid
  assigned_at                      timestamptz
  batch_date                       date [not null]
  cancellation_reason              varchar(500)
  cancelled_at                     timestamptz
  code                             text
  completed_at                     timestamptz
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  handed_off_at                    timestamptz
  hub_id                           uuid
  manifested_at                    timestamptz
  market_id                        uuid [not null]
  market_session_id                uuid
  status                           varchar(20) [not null, default: 'Built']
  total_item_count                 integer [not null]
  updated_at                       timestamptz [not null]

  Indexes {
    code [unique, name: 'IX_procurement_batches_code', note: 'WHERE code IS NOT NULL']
    (batch_date, market_id) [name: 'idx_procurement_batches_batch_date_market_id']
    (hub_id, batch_date) [name: 'idx_procurement_batches_hub_date', note: 'WHERE "deleted_at" IS NULL']
    assigned_agent_user_id [name: 'ix_procurement_batches_assigned_agent', note: 'WHERE "assigned_agent_user_id" IS NOT NULL']
    market_session_id [unique, name: 'ux_procurement_batches_market_session_active', note: 'WHERE market_session_id IS NOT NULL AND status <> \'Cancelled\' AND deleted_at IS NULL']
  }
}

Table procurement_exceptions {
  id                               uuid [pk, not null, default: `gen_random_uuid()`]
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  market_product_id                uuid [not null]
  note                             varchar(500)
  procurement_batch_id             uuid [not null]
  proof_image_url                  varchar(500)
  reported_at                      timestamptz [not null]
  reported_by_user_id              uuid [not null]
  reported_quantity                integer [not null]
  type                             varchar(20) [not null]
  updated_at                       timestamptz [not null]

  Indexes {
    procurement_batch_id [name: 'idx_procurement_exceptions_batch_id']
  }
}

Table product_categories {
  Id                               uuid [pk, not null]
  CreatedAt                        timestamptz [not null]
  DeletedAt                        timestamptz
  ImageUrl                         varchar(512)
  IsActive                         boolean [not null, default: true]
  Name                             varchar(200) [not null]
  ParentId                         uuid
  UpdatedAt                        timestamptz [not null]

  Indexes {
    IsActive [name: 'IX_product_categories_IsActive']
    Name [unique, name: 'IX_product_categories_Name', note: 'WHERE "DeletedAt" IS NULL']
    ParentId [name: 'IX_product_categories_ParentId']
  }
}

Table products {
  Id                               uuid [pk, not null]
  CategoryId                       uuid
  CreatedAt                        timestamptz [not null]
  CreatedBy                        uuid
  DeletedAt                        timestamptz
  Description                      varchar(1000)
  ImageUrl                         varchar(512)
  MinimumOrderQuantity             integer [not null, default: 1]
  Name                             varchar(200) [not null]
  PackingCodeId                    uuid
  UnitId                           uuid [not null]
  UpdatedAt                        timestamptz [not null]
  VatRate                          varchar(10)
  category                         text
  unit                             text

  Indexes {
    CategoryId [name: 'IX_products_CategoryId']
    DeletedAt [name: 'IX_products_DeletedAt']
    Name [name: 'IX_products_Name']
    PackingCodeId [name: 'IX_products_PackingCodeId']
    UnitId [name: 'IX_products_UnitId']
  }
}

Table refresh_tokens {
  Id                               uuid [pk, not null]
  CreatedAt                        timestamptz [not null]
  ExpiresAt                        timestamptz [not null]
  FamilyId                         uuid [not null]
  ReplacedByTokenId                uuid
  RevokedAt                        timestamptz
  RevokedReason                    varchar(50)
  TokenHash                        text [not null, unique]
  UserId                           uuid [not null]

  Indexes {
    FamilyId [name: 'IX_refresh_tokens_FamilyId']
    ReplacedByTokenId [name: 'IX_refresh_tokens_ReplacedByTokenId']
    TokenHash [unique, name: 'IX_refresh_tokens_TokenHash']
    UserId [name: 'IX_refresh_tokens_UserId']
  }
}

Table restaurant_credit {
  restaurant_id                    uuid [pk, not null]
  credit_limit                     numeric(14,2) [not null]
  last_alerted_level               varchar(20) [not null]
  outstanding_balance              numeric(14,2) [not null]
  updated_at                       timestamptz [not null]
}

Table restaurant_favorites {
  id                               uuid [pk, not null]
  created_at                       timestamptz [not null]
  market_product_id                uuid [not null]
  restaurant_id                    uuid [not null]

  Indexes {
    restaurant_id [name: 'idx_restaurant_favorites_restaurant_id']
    (restaurant_id, market_product_id) [unique, name: 'ux_restaurant_favorites_restaurant_id_market_product_id']
  }
}

Table restaurants {
  Id                               uuid [pk, not null]
  Address                          varchar(500)
  BusinessLicenseUrl               varchar(512)
  ContactPerson                    varchar(200)
  CreatedAt                        timestamptz [not null]
  InvoiceAddress                   varchar(256)
  InvoiceEmail                     varchar(256)
  InvoiceLegalName                 varchar(300)
  Name                             varchar(200) [not null]
  PickupEnd                        time
  PickupStart                      time
  TaxCode                          varchar(20)
  UpdatedAt                        timestamptz [not null]
  UserId                           uuid [not null, unique]
  status                           varchar(20) [not null, default: 'Pending']

  Indexes {
    UserId [unique, name: 'IX_restaurants_UserId']
  }
}

Table roles {
  Id                               uuid [pk, not null]
  CreatedAt                        timestamptz [not null]
  Description                      varchar(255) [not null]
  Name                             varchar(50) [not null, unique]

  Indexes {
    Name [unique, name: 'IX_roles_Name']
  }
}

Table route_matrix_cache {
  pair_key                         text [pk, not null]
  calculated_at                    timestamptz [not null]
  distance_meters                  bigint [not null]
  duration_seconds                 bigint [not null]
  from_lat                         numeric [not null]
  from_lng                         numeric [not null]
  profile                          text [not null]
  to_lat                           numeric [not null]
  to_lng                           numeric [not null]
}

Table route_plans {
  id                               uuid [pk, not null]
  approved_at                      timestamptz
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  estimated_cost                   numeric(16,2) [not null]
  estimated_duration_minutes       integer [not null]
  hub_id                           uuid [not null]
  input_revision                   varchar(64) [not null]
  is_estimated                     boolean [not null]
  market_session_id                uuid [not null]
  optimization_criteria            varchar(20) [not null]
  routing_provider                 varchar(40) [not null]
  service_date                     date [not null]
  status                           varchar(20) [not null]
  total_distance_km                numeric(14,2) [not null]
  total_load_kg                    numeric(14,3) [not null]
  unassigned_json                  jsonb [not null]
  vehicles_used                    integer [not null]

  Indexes {
    input_revision [name: 'idx_route_plans_input_revision']
    (hub_id, service_date) [unique, name: 'ux_route_plans_hub_date_proposed', note: 'WHERE status = \'proposed\' AND deleted_at IS NULL']
  }
  Note: 'CHECK ck_route_plans_status: status IN (\'proposed\',\'approved\',\'stale\',\'superseded\')'
}

Table scheduled_order_items {
  Id                               uuid [pk, not null]
  CreatedAt                        timestamptz [not null]
  MarketProductId                  uuid [not null]
  Quantity                         integer [not null]
  ScheduledOrderId                 uuid [not null]
  UpdatedAt                        timestamptz [not null]

  Indexes {
    MarketProductId [name: 'idx_scheduled_order_items_market_product_id']
    ScheduledOrderId [name: 'idx_scheduled_order_items_scheduled_order_id']
  }
}

Table scheduled_orders {
  Id                               uuid [pk, not null]
  CancelledAt                      timestamptz
  CreatedAt                        timestamptz [not null]
  DeliveryAddressId                uuid
  FirstRunAt                       timestamptz [not null]
  LastExecutedAt                   timestamptz
  Notes                            text
  RecurrenceType                   varchar(20) [not null]
  RestaurantId                     uuid [not null]
  UpdatedAt                        timestamptz [not null]
  deleted_at                       timestamptz
  market_id                        uuid

  Indexes {
    deleted_at [name: 'IX_scheduled_orders_deleted_at']
    RestaurantId [name: 'idx_scheduled_orders_restaurant_id']
  }
}

Table tags {
  id                               uuid [pk, not null]
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  name                             varchar(30) [not null]
  pins_to_top                      boolean [not null, default: false]
  updated_at                       timestamptz [not null]
  updated_by                       uuid

  Indexes {
    name [unique, name: 'idx_tags_name_unique', note: 'WHERE "deleted_at" IS NULL']
  }
}

Table units_of_measurement {
  Id                               uuid [pk, not null]
  Abbreviation                     varchar(20)
  CreatedAt                        timestamptz [not null]
  DeletedAt                        timestamptz
  IsActive                         boolean [not null, default: true]
  Name                             varchar(100) [not null]
  UpdatedAt                        timestamptz [not null]

  Indexes {
    IsActive [name: 'IX_units_of_measurement_IsActive']
    Name [unique, name: 'IX_units_of_measurement_Name', note: 'WHERE "DeletedAt" IS NULL']
  }
}

Table user_market_assignments {
  Id                               uuid [pk, not null]
  AssignedBy                       uuid
  CreatedAt                        timestamptz [not null]
  MarketId                         uuid [not null]
  UpdatedAt                        timestamptz [not null]
  UserId                           uuid [not null]

  Indexes {
    MarketId [name: 'IX_user_market_assignments_MarketId']
    (UserId, MarketId) [unique, name: 'IX_user_market_assignments_UserId_MarketId']
  }
}

Table users {
  Id                               uuid [pk, not null]
  AvatarUrl                        varchar(512)
  CreatedAt                        timestamptz [not null]
  DeletedAt                        timestamptz
  Email                            varchar(255) [not null]
  EmailVerifiedAt                  timestamptz
  FailedLoginCount                 integer [not null, default: 0]
  FullName                         varchar(255)
  IsActive                         boolean [not null, default: true]
  LockedUntil                      timestamptz
  PasswordHash                     text [not null]
  Phone                            varchar(20)
  RoleId                           uuid [not null]
  UpdatedAt                        timestamptz [not null]

  Indexes {
    Email [unique, name: 'IX_users_Email', note: 'WHERE "DeletedAt" IS NULL']
    Phone [unique, name: 'IX_users_Phone', note: 'WHERE "Phone" IS NOT NULL AND "DeletedAt" IS NULL']
    RoleId [name: 'IX_users_RoleId']
  }
}

Table vehicles {
  id                               uuid [pk, not null]
  capacity_kg                      numeric(10,2) [not null]
  created_at                       timestamptz [not null]
  deleted_at                       timestamptz
  hub_id                           uuid
  is_available                     boolean [not null, default: true]
  plate_number                     varchar(20) [not null]
  registered_by                    uuid
  updated_at                       timestamptz [not null]
  vehicle_type                     varchar(20) [not null]

  Indexes {
    deleted_at [name: 'idx_vehicles_deleted_at']
    hub_id [name: 'idx_vehicles_hub_id', note: 'WHERE deleted_at IS NULL']
    plate_number [unique, name: 'ux_vehicles_plate_number_active', note: 'WHERE deleted_at IS NULL']
  }
}

Table verification_codes {
  Id                               uuid [pk, not null]
  Channel                          varchar(10) [not null]
  CodeHash                         varchar(128) [not null]
  CreatedAt                        timestamptz [not null]
  ExpiresAt                        timestamptz [not null]
  UsedAt                           timestamptz
  UserId                           uuid [not null]

  Indexes {
    CodeHash [name: 'IX_verification_codes_CodeHash']
    UserId [name: 'IX_verification_codes_UserId']
  }
}

// Enforced database relationships
Ref: credit_statement_lines.credit_statement_id > credit_statements.id [delete: cascade]
Ref: cross_dock_transfers.hub_id > hubs.id [delete: restrict]
Ref: cross_dock_transfers.inbound_event_id > hub_inbound_events.id [delete: restrict]
Ref: deliveries.delivery_route_id > delivery_routes.id [delete: restrict]
Ref: delivery_addresses.RestaurantId > restaurants.Id [delete: cascade]
Ref: delivery_issues.delivery_id > deliveries.id [delete: restrict]
Ref: delivery_routes.route_plan_id > route_plans.id [delete: restrict]
Ref: hub_discrepancies.hub_id > hubs.id [delete: restrict]
Ref: hub_discrepancies.inbound_event_id > hub_inbound_events.id [delete: restrict]
Ref: hub_driver_assignments.hub_id > hubs.id [delete: cascade]
Ref: hub_handover_events.hub_id > hubs.id [delete: restrict]
Ref: hub_handover_events.outbound_event_id > hub_outbound_events.id [delete: restrict]
Ref: hub_inbound_events.hub_id > hubs.id [delete: restrict]
Ref: hub_inventory.hub_id > hubs.id [delete: restrict]
Ref: hub_outbound_events.hub_id > hubs.id [delete: restrict]
Ref: hub_staff_assignments.hub_id > hubs.id [delete: cascade]
Ref: invoice_lines.invoice_id > invoices.id [delete: cascade]
Ref: market_product_tags.market_product_id > market_products.Id [delete: cascade]
Ref: market_product_tags.tag_id > tags.id [delete: restrict]
Ref: market_session_agents.session_id > market_sessions.id [delete: cascade]
Ref: market_session_vehicles.session_id > market_sessions.id [delete: cascade]
Ref: order_claims.OrderId > orders.Id [delete: restrict]
Ref: order_claims.RefundTransactionId > credit_transactions.id [delete: restrict]
Ref: order_issues.order_id > orders.Id [delete: cascade]
Ref: order_issues.order_item_id > order_items.Id [delete: set null]
Ref: order_items.OrderId > orders.Id [delete: cascade]
Ref: password_reset_tokens.UserId > users.Id [delete: cascade]
Ref: price_snapshots.MarketProductId > market_products.Id [delete: cascade]
Ref: procurement_batch_items.procurement_batch_id > procurement_batches.id [delete: cascade]
Ref: procurement_batch_orders.procurement_batch_id > procurement_batches.id [delete: cascade]
Ref: procurement_batches.market_session_id > market_sessions.id [delete: restrict]
Ref: procurement_exceptions.procurement_batch_id > procurement_batches.id [delete: cascade]
Ref: product_categories.ParentId > product_categories.Id [delete: restrict]
Ref: products.PackingCodeId > packing_codes.Id [delete: set null]
Ref: products.CategoryId > product_categories.Id [delete: set null]
Ref: products.UnitId > units_of_measurement.Id [delete: restrict]
Ref: refresh_tokens.ReplacedByTokenId > refresh_tokens.Id [delete: set null]
Ref: refresh_tokens.UserId > users.Id [delete: cascade]
Ref: scheduled_order_items.ScheduledOrderId > scheduled_orders.Id [delete: cascade]
Ref: user_market_assignments.UserId > users.Id [delete: cascade]
Ref: users.RoleId > roles.Id [delete: restrict]
Ref: verification_codes.UserId > users.Id [delete: cascade]

TableGroup "Auth" {
  delivery_addresses
  driver_profiles
  password_reset_tokens
  refresh_tokens
  restaurants
  roles
  user_market_assignments
  users
  verification_codes
}
TableGroup "Catalog" {
  markets
  packing_codes
  product_categories
  products
  units_of_measurement
}
TableGroup "Hub" {
  cross_dock_transfers
  hub_discrepancies
  hub_driver_assignments
  hub_handover_events
  hub_inbound_events
  hub_inventory
  hub_outbound_events
  hub_sorting_progress
  hub_staff_assignments
  hubs
}
TableGroup "Invoicing" {
  invoice_lines
  invoices
}
TableGroup "Logistics" {
  deliveries
  delivery_issues
  delivery_routes
  route_matrix_cache
  route_plans
  vehicles
}
TableGroup "Notifications" {
  notification_devices
  notifications
}
TableGroup "Orders" {
  credit_statement_lines
  credit_statements
  credit_transactions
  operational_settings
  order_claims
  order_issues
  order_items
  orders
  restaurant_credit
  restaurant_favorites
  scheduled_order_items
  scheduled_orders
}
TableGroup "Platform" {
  assistant_conversations
  audit_logs
}
TableGroup "Pricing" {
  market_product_tags
  market_products
  price_snapshots
  tags
}
TableGroup "Procurement" {
  market_session_agents
  market_session_vehicles
  market_sessions
  procurement_batch_items
  procurement_batch_orders
  procurement_batches
  procurement_exceptions
}
