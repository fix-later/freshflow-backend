  }
  Note: 'CHECK ck_hub_inventory_quantity_available_non_negative: quantity_in >= quantity_out; CHECK ck_hub_inventory_quantity_in_non_negative: quantity_in >= 0; CHECK ck_hub_inventory_quantity_out_non_negative: quantity_out >= 0'
}

