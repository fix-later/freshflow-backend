  Indexes {
    created_at [name: 'idx_credit_transactions_created_at']
    order_id [name: 'idx_credit_transactions_order_id']
    restaurant_id [name: 'idx_credit_transactions_restaurant_id']
    (restaurant_id, reference) [unique, name: 'uq_credit_transactions_settlement_reference', note: 'WHERE type = \'settlement\' AND reference IS NOT NULL']
  }
  Note: 'CHECK ck_credit_transactions_settlement_reference: type <> \'settlement\' OR (reference IS NOT NULL AND btrim(reference) <> \'\')'
}

