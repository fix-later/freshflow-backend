  <diagram id="request-pipeline" name="04 - Request Pipeline">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="HTTP REQUEST PIPELINE - CONTROLLER TO DATABASE AND POST-COMMIT EVENTS" style="text;html=1;align=center;verticalAlign=middle;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="255" y="25" width="1090" height="50" as="geometry"/></mxCell>

        <mxCell id="client" value="Client&lt;br&gt;REST request&lt;br&gt;Authorization header" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="120" height="95" as="geometry"/></mxCell>
        <mxCell id="pipeline" value="ASP.NET Core pipeline&lt;br&gt;ForwardedHeaders&lt;br&gt;CORS&lt;br&gt;Authentication&lt;br&gt;Authorization&lt;br&gt;RateLimiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="controller" value="Controller action&lt;br&gt;Auth / Admin / Markets / Orders / Assistant / Profile / Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="sender" value="MediatR ISender&lt;br&gt;ValidationBehavior&lt;br&gt;FluentValidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="185" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="handler" value="Command / Query handler&lt;br&gt;business use case&lt;br&gt;Result&lt;T&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="185" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="repo" value="Repository / service&lt;br&gt;EF Core abstraction&lt;br&gt;cross-module reader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="185" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL&lt;br&gt;AppDbContext&lt;br&gt;SaveChangesAsync" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="events" value="DomainEventDispatchInterceptor&lt;br&gt;SavedChangesAsync hook&lt;br&gt;publish post-commit via MediatR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="side-effects" value="Post-commit side effects&lt;br&gt;SignalR broadcasts&lt;br&gt;Redis cache writes&lt;br&gt;integration events&lt;br&gt;email delivery paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="response" value="API envelope&lt;br&gt;success/data/meta&lt;br&gt;or error/code/message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="440" width="180" height="100" as="geometry"/></mxCell>

        <mxCell id="note1" value="Global exception handler converts FluentValidation exceptions into VALIDATION_ERROR envelope. JWT challenge/forbidden also return JSON envelopes." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="625" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="note2" value="Post-commit event handler failures are logged and not re-thrown. There is no durable outbox in the current implementation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="625" width="430" height="90" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="client" target="pipeline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="route" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pipeline" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Send(command/query)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="controller" target="sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="validated dispatch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sender" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="load / save" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="handler" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="repo" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="post-commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="db" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="events" target="side-effects"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Result&lt;T&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="handler" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="envelope" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="controller" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="HTTP response" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="response" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="realtime-orders-pricing" name="05 - Realtime Flows">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
