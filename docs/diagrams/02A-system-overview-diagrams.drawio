        <mxCell id="markets" value="MarketsController&lt;br&gt;PATCH price / quantity&lt;br&gt;role: market_agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="215" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="pricing-handler" value="Pricing command handler&lt;br&gt;validate market assignment&lt;br&gt;update price/quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="215" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="pg-price" value="PostgreSQL&lt;br&gt;market_products&lt;br&gt;price_snapshots" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="385" width="160" height="105" as="geometry"/></mxCell>
        <mxCell id="price-event" value="PriceUpdatedDomainEvent&lt;br&gt;post-commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="405" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis cache&lt;br&gt;latest price board" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="155" y="545" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="pricing-hub" value="PricingHub&lt;br&gt;/hubs/pricing&lt;br&gt;group: market:{marketId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="540" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="price-clients" value="Subscribed clients&lt;br&gt;admin / restaurant / agent" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="545" width="115" height="90" as="geometry"/></mxCell>

        <mxCell id="restaurant" value="Restaurant user" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="865" y="230" width="110" height="85" as="geometry"/></mxCell>
        <mxCell id="orders-controller" value="OrdersController&lt;br&gt;draft / confirm / cancel&lt;br&gt;role-based auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035" y="215" width="165" height="95" as="geometry"/></mxCell>
        <mxCell id="orders-handler" value="Orders command handler&lt;br&gt;business rule + credit&lt;br&gt;domain state transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="215" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="pg-orders" value="PostgreSQL&lt;br&gt;orders, order_items,&lt;br&gt;restaurant_credit,&lt;br&gt;credit_transactions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1275" y="385" width="170" height="115" as="geometry"/></mxCell>
        <mxCell id="order-event" value="OrderStatusChangedDomainEvent&lt;br&gt;post-commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="410" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="order-hub" value="OrderHub&lt;br&gt;/hubs/orders&lt;br&gt;restaurant:{id}&lt;br&gt;admin:orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1045" y="545" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="order-clients" value="Restaurant / admin / operations&lt;br&gt;subscribed by role" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="550" width="125" height="90" as="geometry"/></mxCell>

        <mxCell id="note1" value="PricingHub JoinMarketAsync checks assignment for non-admin users." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="665" width="270" height="55" as="geometry"/></mxCell>
        <mxCell id="note2" value="OrderHub auto-joins restaurant users by restaurant profile and admin/operations users by role." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035" y="665" width="310" height="55" as="geometry"/></mxCell>

        <mxCell id="pe1" value="PATCH" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="agent" target="markets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" value="MediatR command" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="markets" target="pricing-handler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="save" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pricing-handler" target="pg-price"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" value="post-commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pg-price" target="price-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" value="cache write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="price-event" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" value="broadcast" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="price-event" target="pricing-hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe7" value="PriceUpdated" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pricing-hub" target="price-clients"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="oe1" value="POST/PATCH" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="restaurant" target="orders-controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe2" value="MediatR command" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="orders-controller" target="orders-handler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" value="save" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="orders-handler" target="pg-orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" value="post-commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pg-orders" target="order-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" value="broadcast" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="order-event" target="order-hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" value="status update" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="order-hub" target="order-clients"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="assistant-flow" name="06 - AI Assistant Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI ASSISTANT FLOW - HOST-LAYER ORCHESTRATION" style="text;html=1;align=center;verticalAlign=middle;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="25" width="860" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Assistant is not a standalone domain module. It calls existing MediatR commands/queries through tool wrappers." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="75" width="880" height="30" as="geometry"/></mxCell>

        <mxCell id="restaurant" value="Restaurant user&lt;br&gt;JWT role: restaurant" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="230" width="120" height="95" as="geometry"/></mxCell>
        <mxCell id="controller" value="AssistantController&lt;br&gt;POST /api/v1/assistant/chat&lt;br&gt;rate limit: assistant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="orchestrator" value="AssistantOrchestrator&lt;br&gt;tool loop&lt;br&gt;max tool hops&lt;br&gt;safety gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="215" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="store" value="DbConversationStore&lt;br&gt;load/save ConversationState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="430" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL&lt;br&gt;assistant_conversations&lt;br&gt;JSONB state + TTL columns" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="llm" value="ZenMuxChatClient&lt;br&gt;OpenAI-compatible&lt;br&gt;Microsoft.Extensions.AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="150" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="zenmux" value="ZenMux API&lt;br&gt;LLM provider" style="cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1115" y="155" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="registry" value="AssistantToolRegistry&lt;br&gt;JSON args parser&lt;br&gt;tool definitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="350" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="sender" value="MediatR ISender&lt;br&gt;existing commands / queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="350" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="modules" value="Existing modules&lt;br&gt;Pricing queries&lt;br&gt;Orders commands&lt;br&gt;Auth context through JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="330" width="170" height="125" as="geometry"/></mxCell>
        <mxCell id="gate" value="ConfirmationGate&lt;br&gt;blocks confirm_order unless UI/user confirmation matches target order" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="835" y="565" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="safety" value="Safety rules&lt;br&gt;No direct DB writes by LLM&lt;br&gt;No business rules in tool wrappers&lt;br&gt;State changes go through Application layer&lt;br&gt;Sensitive data should be minimized before prompt/tool result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="555" width="330" height="130" as="geometry"/></mxCell>

        <mxCell id="e1" value="chat request" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="restaurant" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="user + market + session" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="controller" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="load / save" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="orchestrator" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="store" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="system prompt + history + tools" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="orchestrator" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="llm" target="zenmux"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="text or tool_call" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="llm" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="invoke tool" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="orchestrator" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="ISender.Send" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="registry" target="sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="handler" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sender" target="modules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Result JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="registry" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="guard confirm_order" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="orchestrator" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="response" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="controller" target="restaurant"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
